+<?xml version="1.0" encoding="utf-8"?>
+<!-- bravia: the Christmas screensaver (HolidayDream). Two video layers that crossfade, a soft shade in the
+     bottom-left corner, and Home's own type for the greeting, the day's line, the time and the date. -->
+<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
+    android:layout_width="match_parent"
+    android:layout_height="match_parent"
+    android:background="#FF000000">
+
+    <TextureView
+        android:id="@+id/holidayVideoA"
+        android:layout_width="match_parent"
+        android:layout_height="match_parent" />
+
+    <TextureView
+        android:id="@+id/holidayVideoB"
+        android:layout_width="match_parent"
+        android:layout_height="match_parent"
+        android:alpha="0" />
+
+    <View
+        android:id="@+id/holidayShade"
+        android:layout_width="match_parent"
+        android:layout_height="match_parent" />
+
+    <LinearLayout
+        android:id="@+id/holidayText"
+        android:layout_width="wrap_content"
+        android:layout_height="wrap_content"
+        android:layout_gravity="bottom|start"
+        android:layout_marginStart="72dp"
+        android:layout_marginBottom="52dp"
+        android:orientation="vertical">
+
+        <TextView
+            android:id="@+id/holidayGreeting"
+            android:layout_width="wrap_content"
+            android:layout_height="wrap_content"
+            android:fontFamily="@string/font_medium"
+            android:letterSpacing="0.22"
+            android:shadowColor="#99000000"
+            android:shadowRadius="8"
+            android:textAllCaps="true"
+            android:textSize="14sp" />
+
+        <TextView
+            android:id="@+id/holidayLine"
+            android:layout_width="wrap_content"
+            android:layout_height="wrap_content"
+            android:layout_marginTop="6dp"
+            android:fontFamily="@string/font_light"
+            android:maxWidth="560dp"
+            android:shadowColor="#99000000"
+            android:shadowRadius="8"
+            android:textColor="#E6FFFFFF"
+            android:textSize="18sp" />
+
+        <LinearLayout
+            android:layout_width="wrap_content"
+            android:layout_height="wrap_content"
+            android:layout_marginTop="6dp"
+            android:baselineAligned="true"
+            android:orientation="horizontal">
+
+            <TextClock
+                android:id="@+id/holidayClock"
+                android:layout_width="wrap_content"
+                android:layout_height="wrap_content"
+                android:fontFamily="@string/font_light"
+                android:format12Hour="h:mm"
+                android:format24Hour="H:mm"
+                android:letterSpacing="-0.03"
+                android:shadowColor="#99000000"
+                android:shadowRadius="10"
+                android:textColor="#FFFFFFFF"
+                android:textSize="64sp" />
+
+            <TextClock
+                android:id="@+id/holidayAmPm"
+                android:layout_width="wrap_content"
+                android:layout_height="wrap_content"
+                android:layout_marginStart="10dp"
+                android:fontFamily="@string/font_regular"
+                android:format12Hour="a"
+                android:format24Hour=""
+                android:letterSpacing="0.1"
+                android:shadowColor="#99000000"
+                android:shadowRadius="8"
+                android:textAllCaps="true"
+                android:textColor="#CCFFFFFF"
+                android:textSize="16sp" />
+        </LinearLayout>
+
+        <TextClock
+            android:id="@+id/holidayDate"
+            android:layout_width="wrap_content"
+            android:layout_height="wrap_content"
+            android:fontFamily="@string/font_regular"
+            android:letterSpacing="0.14"
+            android:shadowColor="#99000000"
+            android:shadowRadius="8"
+            android:textAllCaps="true"
+            android:textColor="#B3FFFFFF"
+            android:textSize="13sp" />
