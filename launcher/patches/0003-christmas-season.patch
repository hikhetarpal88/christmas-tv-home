@@ -0,0 +1,791 @@
+package com.gathin.tvhome;
+
+import android.content.Context;
+import android.graphics.Bitmap;
+import android.graphics.Canvas;
+import android.graphics.LinearGradient;
+import android.graphics.Paint;
+import android.graphics.Path;
+import android.graphics.PointF;
+import android.graphics.RadialGradient;
+import android.graphics.RectF;
+import android.graphics.Shader;
+import android.util.SparseArray;
+import android.view.View;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Random;
+
+/**
+ * bravia: the Christmas scene's still pieces (HolidayDecor puts them on Home): the night sky, the fairy lights
+ * along the top, the tree of lights with its Advent ornaments, star and presents, the gnome, the cardinal and the
+ * frost. Each is drawn once into a hardware layer and only moved, faded or redrawn when the day changes, so on
+ * this TV's GPU a frame is compositing rather than drawing (the lesson of the Diwali lamps).
+ */
+final class HolidayArt {
+    private HolidayArt() {
+    }
+
+    // ---- shared sprites ---------------------------------------------------------------------------
+
+    private static final SparseArray<Bitmap> GLOWS = new SparseArray<>();
+
+    /**
+     * A soft round glow, white in the middle fading out, size x size pixels, cached by size and colour. Drawn
+     * with a paint's alpha and colour filter it serves as a bulb's halo, a snowflake or a bokeh disc.
+     */
+    static Bitmap glow(int size, int color, float core) {
+        int key = (size * 31 + color) * 7 + Math.round(core * 100);
+        Bitmap b = GLOWS.get(key);
+        if (b != null && !b.isRecycled()) return b;
+        size = Math.max(2, size);
+        b = Bitmap.createBitmap(size, size, Bitmap.Config.ARGB_8888);
+        Canvas c = new Canvas(b);
+        Paint p = new Paint(Paint.ANTI_ALIAS_FLAG);
+        int clear = color & 0x00FFFFFF;
+        p.setShader(new RadialGradient(size / 2f, size / 2f, size / 2f,
+                new int[]{0xFFFFFFFF, color, (color & 0x00FFFFFF) | 0x44000000, clear},
+                new float[]{0f, core, Math.min(1f, core + (1f - core) * 0.45f), 1f}, Shader.TileMode.CLAMP));
+        c.drawCircle(size / 2f, size / 2f, size / 2f, p);
+        GLOWS.put(key, b);
+        return b;
+    }
+
+    static View quiet(View v) {
+        v.setFocusable(false);
+        v.setClickable(false);
+        v.setImportantForAccessibility(View.IMPORTANT_FOR_ACCESSIBILITY_NO);
+        return v;
+    }
+
+    /** A view drawn once and kept as a texture: moving or fading it costs nothing more. */
+    abstract static class Still extends View {
+        final float d;
+
+        Still(Context c) {
+            super(c);
+            d = c.getResources().getDisplayMetrics().density;
+            quiet(this);
+            setWillNotDraw(false);
+            setLayerType(LAYER_TYPE_HARDWARE, null);
+        }
+
+        float dp(float v) {
+            return v * d;
+        }
+    }
+
+    // ---- sky --------------------------------------------------------------------------------------
+
+    /** A clear winter night: deep blue going lighter toward the dock, a field of stars, and on some nights a moon. */
+    static final class WinterSky extends Still {
+        private final Paint grad = new Paint(), warm = new Paint(), star = new Paint(Paint.ANTI_ALIAS_FLAG),
+                glint = new Paint(Paint.ANTI_ALIAS_FLAG), moonHalo = new Paint(Paint.ANTI_ALIAS_FLAG),
+                moonFace = new Paint(Paint.ANTI_ALIAS_FLAG), crater = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private float[] stars = new float[0];
+        private boolean moon, solstice;
+        private float moonX, moonY, moonR;
+
+        WinterSky(Context c) {
+            super(c);
+            glint.setStrokeCap(Paint.Cap.ROUND);
+        }
+
+        /** moon: a big low moon (Christmas Eve's near-full supermoon); solstice: the darkest sky, twice the stars. */
+        void setNight(boolean moon, boolean solstice) {
+            this.moon = moon;
+            this.solstice = solstice;
+            build(getWidth(), getHeight());
+            invalidate();
+        }
+
+        PointF moonCentre() {
+            return moon ? new PointF(moonX, moonY) : null;
+        }
+
+        float moonRadius() {
+            return moonR;
+        }
+
+        @Override
+        protected void onSizeChanged(int w, int h, int ow, int oh) {
+            build(w, h);
+        }
+
+        private void build(int w, int h) {
+            if (w == 0 || h == 0) return;
+            int[] colors = solstice
+                    ? new int[]{0xFF02050C, 0xFF050C1C, 0xFF0B1730, 0xFF081126}
+                    : new int[]{0xFF040913, 0xFF08122A, 0xFF10203E, 0xFF0B1630};
+            grad.setShader(new LinearGradient(0, 0, 0, h, colors, new float[]{0f, 0.35f, 0.7f, 1f},
+                    Shader.TileMode.CLAMP));
+            // a warm breath of light where the tree stands, so it seems to light the room
+            warm.setShader(new RadialGradient(w * 0.81f, h * 0.6f, w * 0.34f,
+                    new int[]{0x22FFB45A, 0x0EFFB45A, 0x00FFB45A}, new float[]{0f, 0.5f, 1f}, Shader.TileMode.CLAMP));
+            Random rnd = new Random(solstice ? 0x5017L : 0x57A2L);
+            int n = solstice ? 260 : 150;
+            stars = new float[n * 4];
+            for (int i = 0; i < n; i++) {
+                float y = (float) Math.pow(rnd.nextFloat(), 1.5) * h * 0.8f;
+                stars[i * 4] = rnd.nextFloat() * w;
+                stars[i * 4 + 1] = y;
+                stars[i * 4 + 2] = dp(0.45f + rnd.nextFloat() * (rnd.nextInt(9) == 0 ? 1.1f : 0.6f));
+                stars[i * 4 + 3] = 50 + rnd.nextInt(170) * (1f - y / h * 0.6f);
+            }
+            moonR = dp(30);
+            moonX = w * 0.53f;
+            moonY = h * 0.3f;
+            moonHalo.setShader(new RadialGradient(moonX, moonY, moonR * 4.2f,
+                    new int[]{0x66FFF6DA, 0x2AFFF0C8, 0x0DFFF0C8, 0x00FFF0C8}, new float[]{0f, 0.28f, 0.55f, 1f},
+                    Shader.TileMode.CLAMP));
+            moonFace.setShader(new RadialGradient(moonX - moonR * 0.25f, moonY - moonR * 0.3f, moonR * 1.25f,
+                    new int[]{0xFFFFFEF6, 0xFFF4EDD6, 0xFFDCD2B2}, new float[]{0f, 0.6f, 1f}, Shader.TileMode.CLAMP));
+            crater.setColor(0x33A89C78);
+        }
+
+        @Override
+        protected void onDraw(Canvas c) {
+            int w = getWidth(), h = getHeight();
+            c.drawRect(0, 0, w, h, grad);
+            c.drawRect(0, 0, w, h, warm);
+            for (int i = 0; i < stars.length; i += 4) {
+                star.setColor(0xFFFFFFFF);
+                star.setAlpha(Math.round(stars[i + 3]));
+                c.drawCircle(stars[i], stars[i + 1], stars[i + 2], star);
+                if (stars[i + 2] > dp(1.45f)) {   // the very brightest get a faint glint
+                    glint.setColor(0x33FFFFFF);
+                    glint.setStrokeWidth(dp(0.4f));
+                    float g = stars[i + 2] * 2.2f;
+                    c.drawLine(stars[i] - g, stars[i + 1], stars[i] + g, stars[i + 1], glint);
+                    c.drawLine(stars[i], stars[i + 1] - g, stars[i], stars[i + 1] + g, glint);
+                }
+            }
+            if (moon) {
+                c.drawCircle(moonX, moonY, moonR * 4.2f, moonHalo);
+                c.drawCircle(moonX, moonY, moonR, moonFace);
+                float[][] spots = {{-0.32f, -0.18f, 0.24f}, {0.18f, -0.34f, 0.15f}, {0.3f, 0.12f, 0.22f},
+                        {-0.12f, 0.36f, 0.17f}, {-0.45f, 0.18f, 0.11f}, {0.05f, 0.02f, 0.1f}};
+                for (float[] s : spots) c.drawCircle(moonX + s[0] * moonR, moonY + s[1] * moonR, s[2] * moonR, crater);
+            }
+        }
+    }
+
+    // ---- fairy lights -----------------------------------------------------------------------------
+
+    static final int WARM = 0xFFFFD98A;
+    static final int[] MULTI = {0xFFFF5A64, 0xFFFFD25A, 0xFF52D68E, 0xFF5AAEFF, 0xFFFF9A48};
+
+    /** Fairy lights strung in shallow swags along the top edge: a dark wire and small warm bulbs. */
+    static final class LightString extends Still {
+        private final Paint wire = new Paint(Paint.ANTI_ALIAS_FLAG), cap = new Paint(Paint.ANTI_ALIAS_FLAG),
+                bulb = new Paint(Paint.ANTI_ALIAS_FLAG), halo = new Paint(Paint.FILTER_BITMAP_FLAG);
+        private final Path wirePath = new Path();
+        private final List<PointF> bulbs = new ArrayList<>();
+        private final RectF tmp = new RectF();
+        private float[] anchors = new float[0];
+        private float sag, top;
+        private boolean multi;
+
+        LightString(Context c) {
+            super(c);
+            wire.setStyle(Paint.Style.STROKE);
+            wire.setStrokeWidth(dp(1.4f));
+            wire.setColor(0xFF15241B);
+            cap.setColor(0xFF1E3326);
+        }
+
+        void setMulticolour(boolean multi) {
+            if (this.multi == multi) return;
+            this.multi = multi;
+            invalidate();
+        }
+
+        boolean multicolour() {
+            return multi;
+        }
+
+        /** The bulbs' centres in this view's pixels. */
+        List<PointF> bulbs() {
+            return bulbs;
+        }
+
+        int bulbColour(int i) {
+            return multi ? MULTI[i % MULTI.length] : WARM;
+        }
+
+        /** Where the wire is at x (this view's pixels). */
+        float wireY(float x) {
+            for (int i = 0; i + 1 < anchors.length; i++) {
+                if (x >= anchors[i] && x <= anchors[i + 1]) {
+                    float mid = (anchors[i] + anchors[i + 1]) / 2f, half = (anchors[i + 1] - anchors[i]) / 2f;
+                    float u = (x - mid) / half;
+                    return top + sag * (1f - u * u);
+                }
+            }
+            return top;
+        }
+
+        @Override
+        protected void onSizeChanged(int w, int h, int ow, int oh) {
+            top = dp(2.5f);
+            sag = dp(15f);
+            int swags = Math.max(4, Math.round(w / dp(165)));
+            float from = -dp(14), to = w + dp(14);
+            anchors = new float[swags + 1];
+            for (int i = 0; i <= swags; i++) anchors[i] = from + (to - from) * i / swags;
+            wirePath.reset();
+            wirePath.moveTo(anchors[0], top);
+            for (int i = 0; i < swags; i++) {
+                float mid = (anchors[i] + anchors[i + 1]) / 2f;
+                // a quadratic through the swag's lowest point at mid: control point twice as deep
+                wirePath.quadTo(mid, top + 2 * sag, anchors[i + 1], top);
+            }
+            bulbs.clear();
+            float step = dp(21);
+            for (float x = anchors[0] + step * 0.6f; x < to; x += step) {
+                if (x < dp(4) || x > w - dp(4)) continue;
+                bulbs.add(new PointF(x, wireY(x) + dp(5.2f)));
+            }
+        }
+
+        @Override
+        protected void onDraw(Canvas c) {
+            c.drawPath(wirePath, wire);
+            int size = Math.round(dp(26));
+            for (int i = 0; i < bulbs.size(); i++) {
+                PointF p = bulbs.get(i);
+                int col = bulbColour(i);
+                Bitmap g = glow(size, col, 0.12f);
+                halo.setAlpha(150);
+                tmp.set(p.x - size / 2f, p.y - size / 2f, p.x + size / 2f, p.y + size / 2f);
+                c.drawBitmap(g, null, tmp, halo);
+                c.drawRect(p.x - dp(1.1f), p.y - dp(4.6f), p.x + dp(1.1f), p.y - dp(2.4f), cap);
+                bulb.setShader(new RadialGradient(p.x - dp(0.6f), p.y - dp(0.8f), dp(3.2f),
+                        new int[]{0xFFFFFFFF, col, darker(col)}, new float[]{0f, 0.55f, 1f}, Shader.TileMode.CLAMP));
+                c.drawOval(p.x - dp(1.9f), p.y - dp(2.6f), p.x + dp(1.9f), p.y + dp(2.8f), bulb);
+            }
+        }
+    }
+
+    static int darker(int c) {
+        int r = (c >> 16) & 0xFF, g = (c >> 8) & 0xFF, b = c & 0xFF;
+        return 0xFF000000 | ((r * 3 / 5) << 16) | ((g * 3 / 5) << 8) | (b * 3 / 5);
+    }
+
+    // ---- tree -------------------------------------------------------------------------------------
+
+    static final int[] ORNAMENT = {0xFFC8142E, 0xFFE8B640, 0xFF8CC4EE, 0xFFDCE1E8, 0xFF1F8A5B, 0xFFC4587E};
+
+    /**
+     * A slim fir lit by a spiral of warm lights. From Advent it carries one more glass ornament each day (24 by
+     * Christmas Eve), a gold star from Christmas Eve and presents from Christmas morning. The view stands with its
+     * bottom edge on the dock.
+     */
+    static final class LightTree extends Still {
+        static final float W = 200, H = 240;
+        private final Paint foliage = new Paint(Paint.ANTI_ALIAS_FLAG), rimLight = new Paint(Paint.ANTI_ALIAS_FLAG),
+                shade = new Paint(Paint.ANTI_ALIAS_FLAG), trunk = new Paint(Paint.ANTI_ALIAS_FLAG),
+                roomGlow = new Paint(Paint.ANTI_ALIAS_FLAG), dim = new Paint(Paint.ANTI_ALIAS_FLAG),
+                lit = new Paint(Paint.ANTI_ALIAS_FLAG), halo = new Paint(Paint.FILTER_BITMAP_FLAG);
+        private final List<Path> tiers = new ArrayList<>();
+        private final List<float[]> lights = new ArrayList<>();   // x, y, front (1/0)
+        private final float[][] spots = new float[24][3];          // x, y, radius in the order they arrive
+        private final RectF tmp = new RectF();
+        private int ornaments;
+        private boolean star, presents;
+        private float cx, top, base;
+
+        LightTree(Context c) {
+            super(c);
+            trunk.setShader(null);
+            dim.setColor(0xFFE7C27A);
+            lit.setColor(0xFFFFF4DA);
+        }
+
+        void setState(int ornaments, boolean star, boolean presents) {
+            this.ornaments = Math.max(0, Math.min(24, ornaments));
+            this.star = star;
+            this.presents = presents;
+            invalidate();
+        }
+
+        int ornaments() {
+            return ornaments;
+        }
+
+        boolean hasStar() {
+            return star;
+        }
+
+        boolean hasPresents() {
+            return presents;
+        }
+
+        /** The lights on the side facing the room, in this view's pixels (laid out first). */
+        List<PointF> frontLights() {
+            List<PointF> out = new ArrayList<>();
+            for (float[] l : lights) if (l[2] != 0f) out.add(new PointF(l[0], l[1]));
+            return out;
+        }
+
+        /** Where ornament i (0-based, in arrival order) hangs, in this view's pixels, with its radius. */
+        float[] ornamentSpot(int i) {
+            return spots[Math.max(0, Math.min(23, i))];
+        }
+
+        /** The star's centre in this view's pixels. */
+        PointF starCentre() {
+            return new PointF(cx, top - dp(3));
+        }
+
+        /** Half the tree's width at height v (0 top, 1 bottom of the branches). */
+        private float half(float v) {
+            return dp(9) + v * dp(72);
+        }
+
+        @Override
+        protected void onSizeChanged(int w, int h, int ow, int oh) {
+            cx = w / 2f;
+            top = dp(24);
+            base = dp(206);
+            tiers.clear();
+            float[][] spans = {{0f, 0.3f}, {0.18f, 0.54f}, {0.42f, 0.8f}, {0.66f, 1f}};
+            for (int k = 0; k < spans.length; k++) {
+                float v0 = spans[k][0], v1 = spans[k][1];
+                float y0 = top + v0 * (base - top), y1 = top + v1 * (base - top);
+                float h0 = k == 0 ? dp(1.5f) : half(v0) * 0.42f, h1 = half(v1) * 1.04f;
+                Path p = new Path();
+                p.moveTo(cx - h0, y0);
+                p.quadTo(cx - h0 - (h1 - h0) * 0.35f, (y0 + y1) / 2f, cx - h1, y1);
+                int scallops = 3 + k;
+                float sw = 2 * h1 / scallops;
+                for (int s = 0; s < scallops; s++) {
+                    float x0 = cx - h1 + s * sw;
+                    p.quadTo(x0 + sw / 2f, y1 + dp(5.5f), x0 + sw, y1);
+                }
+                p.quadTo(cx + h0 + (h1 - h0) * 0.35f, (y0 + y1) / 2f, cx + h0, y0);
+                p.close();
+                tiers.add(p);
+            }
+            foliage.setShader(new LinearGradient(0, top, 0, base + dp(6),
+                    new int[]{0xFF1C5636, 0xFF123F27, 0xFF0A2818}, null, Shader.TileMode.CLAMP));
+            rimLight.setShader(new RadialGradient(cx - dp(34), top + dp(70), dp(110),
+                    new int[]{0x5544A06A, 0x2244A06A, 0x0044A06A}, null, Shader.TileMode.CLAMP));
+            shade.setShader(new LinearGradient(cx - dp(10), 0, cx + dp(80), 0, new int[]{0x00000000, 0x55000000},
+                    null, Shader.TileMode.CLAMP));
+            trunk.setShader(new LinearGradient(cx - dp(7), 0, cx + dp(7), 0,
+                    new int[]{0xFF2A1A10, 0xFF5A3A22, 0xFF2A1A10}, null, Shader.TileMode.CLAMP));
+            roomGlow.setShader(new RadialGradient(cx, (top + base) / 2f + dp(10), dp(96),
+                    new int[]{0x26FFC46A, 0x0EFFC46A, 0x00FFC46A}, new float[]{0f, 0.5f, 1f}, Shader.TileMode.CLAMP));
+            lights.clear();
+            int n = 96;
+            for (int i = 0; i < n; i++) {
+                float t = 0.03f + 0.96f * i / (n - 1);
+                double th = t * Math.PI * 2 * 5.4 + 0.6;
+                float hw = half(t) * 0.9f;
+                float x = cx + hw * (float) Math.sin(th);
+                float y = top + t * (base - top) + dp(2.5f) * (float) Math.cos(th);
+                lights.add(new float[]{x, y, Math.cos(th) > -0.1 ? 1f : 0f});
+            }
+            int[] rows = {1, 2, 3, 4, 4, 5, 5};
+            float[] vs = {0.17f, 0.29f, 0.41f, 0.53f, 0.65f, 0.77f, 0.89f};
+            List<float[]> all = new ArrayList<>();
+            Random rnd = new Random(0xAD7E17L);
+            for (int r = 0; r < rows.length; r++) {
+                for (int j = 0; j < rows[r]; j++) {
+                    float u = rows[r] == 1 ? 0f : -0.72f + 1.44f * j / (rows[r] - 1);
+                    u += (r % 2 == 0 ? 0.08f : -0.08f) + (rnd.nextFloat() - 0.5f) * 0.1f;
+                    float v = vs[r] + (rnd.nextFloat() - 0.5f) * 0.03f;
+                    all.add(new float[]{cx + u * half(v), top + v * (base - top), dp(3.6f + 2.6f * v)});
+                }
+            }
+            // arrival order: spread out, never two neighbours on consecutive days
+            int[] order = {12, 3, 20, 7, 16, 0, 22, 10, 5, 18, 14, 1, 23, 8, 19, 4, 11, 21, 6, 15, 2, 17, 9, 13};
+            for (int i = 0; i < 24; i++) spots[i] = all.get(order[i]);
+        }
+
+        @Override
+        protected void onDraw(Canvas c) {
+            int w = getWidth(), h = getHeight();
+            c.drawCircle(cx, (top + base) / 2f + dp(10), dp(96), roomGlow);
+            c.drawRect(cx - dp(7), base - dp(8), cx + dp(7), h - dp(3), trunk);
+            for (Path p : tiers) {
+                c.drawPath(p, foliage);
+                c.drawPath(p, rimLight);
+                c.drawPath(p, shade);
+            }
+            int size = Math.round(dp(16));
+            for (float[] l : lights) {
+                if (l[2] != 0f) continue;
+                dim.setAlpha(90);
+                c.drawCircle(l[0], l[1], dp(1.0f), dim);
+            }
+            for (int i = 0; i < ornaments; i++) drawOrnament(c, spots[i][0], spots[i][1], spots[i][2], i, d);
+            for (float[] l : lights) {
+                if (l[2] == 0f) continue;
+                halo.setAlpha(170);
+                tmp.set(l[0] - size / 2f, l[1] - size / 2f, l[0] + size / 2f, l[1] + size / 2f);
+                c.drawBitmap(glow(size, 0xFFFFD27A, 0.1f), null, tmp, halo);
+                c.drawCircle(l[0], l[1], dp(1.35f), lit);
+            }
+            if (star) drawStar(c, cx, top - dp(3), dp(13), d);
+            if (presents) drawPresents(c, cx, h, 0f, d);
+        }
+
+        static void drawOrnament(Canvas c, float x, float y, float r, int i, float d) {
+            int col = ORNAMENT[i % ORNAMENT.length];
+            Paint p = new Paint(Paint.ANTI_ALIAS_FLAG);
+            p.setColor(0x55000000);
+            c.drawCircle(x + r * 0.18f, y + r * 0.28f, r * 1.02f, p);
+            p.setShader(new RadialGradient(x - r * 0.38f, y - r * 0.42f, r * 1.5f,
+                    new int[]{lighter(col), col, darker(col), 0xFF1A0B08}, new float[]{0f, 0.35f, 0.8f, 1f},
+                    Shader.TileMode.CLAMP));
+            c.drawCircle(x, y, r, p);
+            p.setShader(null);
+            p.setColor(0xFFD7B060);
+            c.drawRect(x - r * 0.3f, y - r - d * 1.6f, x + r * 0.3f, y - r + d * 0.4f, p);
+            p.setColor(0xC8FFFFFF);
+            c.drawOval(x - r * 0.62f, y - r * 0.6f, x - r * 0.12f, y - r * 0.22f, p);
+        }
+
+        static int lighter(int c) {
+            int r = (c >> 16) & 0xFF, g = (c >> 8) & 0xFF, b = c & 0xFF;
+            return 0xFF000000 | ((r + (255 - r) / 2) << 16) | ((g + (255 - g) / 2) << 8) | (b + (255 - b) / 2);
+        }
+
+        static void drawStar(Canvas c, float x, float y, float r, float d) {
+            Paint p = new Paint(Paint.ANTI_ALIAS_FLAG);
+            p.setShader(new RadialGradient(x, y, r * 3.2f, new int[]{0x99FFE9A8, 0x33FFE9A8, 0x00FFE9A8},
+                    new float[]{0f, 0.4f, 1f}, Shader.TileMode.CLAMP));
+            c.drawCircle(x, y, r * 3.2f, p);
+            Path s = new Path();
+            for (int i = 0; i < 10; i++) {
+                double a = -Math.PI / 2 + i * Math.PI / 5;
+                float rr = i % 2 == 0 ? r : r * 0.43f;
+                float px = x + rr * (float) Math.cos(a), py = y + rr * (float) Math.sin(a);
+                if (i == 0) s.moveTo(px, py);
+                else s.lineTo(px, py);
+            }
+            s.close();
+            p.setShader(new RadialGradient(x - r * 0.3f, y - r * 0.35f, r * 1.3f,
+                    new int[]{0xFFFFF8DA, 0xFFF6CB57, 0xFFC4861C}, new float[]{0f, 0.5f, 1f}, Shader.TileMode.CLAMP));
+            c.drawPath(s, p);
+            p.setShader(null);
+            p.setStyle(Paint.Style.STROKE);
+            p.setStrokeWidth(d * 0.8f);
+            p.setStrokeJoin(Paint.Join.ROUND);
+            p.setColor(0xFF7A4D0E);
+            c.drawPath(s, p);
+        }
+
+        /**
+         * Three wrapped presents standing on bottom, around cx; lift raises them (for the moment they arrive).
+         */
+        static void drawPresents(Canvas c, float cx, float bottom, float lift, float d) {
+            float[][] boxes = {
+                    // left offset, width, height, body colour, ribbon colour
+                    {-86, 46, 30, 0xFFB3122E, 0xFFE8B640},
+                    {-22, 36, 40, 0xFF1F6B47, 0xFFD22A3A},
+                    {22, 32, 23, 0xFFE9ECF2, 0xFF3B6FB6},
+            };
+            Paint p = new Paint(Paint.ANTI_ALIAS_FLAG);
+            for (float[] b : boxes) {
+                float l = cx + b[0] * d, w = b[1] * d, h = b[2] * d, btm = bottom - d * 2 - lift;
+                int body = (int) (long) b[3], ribbon = (int) (long) b[4];
+                p.setShader(null);
+                p.setColor(0x44000000);
+                c.drawOval(l - d * 3, btm - d * 3, l + w + d * 3, btm + d * 3, p);
+                p.setShader(new LinearGradient(0, btm - h, 0, btm, new int[]{lighterBy(body, 0.18f), darker(body)},
+                        null, Shader.TileMode.CLAMP));
+                c.drawRect(l, btm - h, l + w, btm, p);
+                p.setShader(null);
+                p.setColor(lighterBy(body, 0.28f));
+                c.drawRect(l - d * 1.5f, btm - h - d * 1.5f, l + w + d * 1.5f, btm - h + d * 4f, p);
+                p.setColor(ribbon);
+                c.drawRect(l + w / 2f - d * 2.6f, btm - h - d * 1.5f, l + w / 2f + d * 2.6f, btm, p);
+                c.drawRect(l, btm - h * 0.55f - d * 2f, l + w, btm - h * 0.55f + d * 2f, p);
+                p.setColor(darker(ribbon));
+                float bx = l + w / 2f, by = btm - h - d * 1.5f;
+                c.save();
+                c.rotate(-28, bx, by);
+                c.drawOval(bx - d * 9, by - d * 4, bx, by + d * 1.5f, p);
+                c.restore();
+                c.save();
+                c.rotate(28, bx, by);
+                c.drawOval(bx, by - d * 4, bx + d * 9, by + d * 1.5f, p);
+                c.restore();
+                p.setColor(ribbon);
+                c.drawCircle(bx, by, d * 2.4f, p);
+            }
+        }
+    }
+
+    static int lighterBy(int c, float t) {
+        int r = (c >> 16) & 0xFF, g = (c >> 8) & 0xFF, b = c & 0xFF;
+        return 0xFF000000 | ((int) (r + (255 - r) * t) << 16) | ((int) (g + (255 - g) * t) << 8)
+                | (int) (b + (255 - b) * t);
+    }
