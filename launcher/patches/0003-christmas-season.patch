+            case "lights_on":
+                if (lights == null) return false;
+                lights.animate().alpha(1f).setDuration(1600).start();
+                playMoment(new HolidayMoments.Chase(activity, lights), 1800, null);
+                return true;
+            case "gnome_arrives": {
+                if (gnome == null) return false;
+                gnomeShown = true;
+                place();
+                gnome.setAlpha(1f);
+                gnome.setPivotY(gnome.getHeight());
+                gnome.setScaleX(0f);
+                gnome.setScaleY(0f);
+                gnome.animate().scaleX(1f).scaleY(1f).setDuration(650).setInterpolator(new OvershootInterpolator(2.2f))
+                        .withEndAction(() -> {
