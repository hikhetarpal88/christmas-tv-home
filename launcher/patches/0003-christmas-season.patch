+package com.gathin.tvhome;
+
+import android.animation.ValueAnimator;
+import android.graphics.Canvas;
+import android.graphics.ColorFilter;
+import android.graphics.ColorMatrix;
+import android.graphics.ColorMatrixColorFilter;
+import android.graphics.LinearGradient;
+import android.graphics.Paint;
+import android.graphics.Path;
+import android.graphics.PixelFormat;
+import android.graphics.RadialGradient;
+import android.graphics.Rect;
+import android.graphics.RectF;
+import android.graphics.Shader;
+import android.graphics.drawable.Drawable;
+import android.view.animation.DecelerateInterpolator;
+import android.view.animation.LinearInterpolator;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+
+/**
+ * bravia: the top bar's Christmas icons, in place of the Diwali ones while a "christmas" festival is on: a gold
+ * bell with a red bow for Inputs (it rings when the pill takes focus), a glass bauble for the network (it swings,
+ * and greys out while offline) and a snowflake for Settings (it turns a sixth). Like the Diwali icons each is
+ * drawn in a 24 x 24 unit box scaled into its bounds, and keeps its own colours (the pills don't tint it).
+ * {@link KnitPill} is the pills' background on Ugly Sweater Day.
+ */
+final class HolidayIcons {
+    private HolidayIcons() {
+    }
+
+    /** An icon that hangs from a point near its top and swings there: a damped swing that dies within a second. */
+    abstract static class Swinging extends Drawable {
+        static final float BOX = 24f;
+        private final float density;
+        private final float amplitude;
+        private final ValueAnimator animator;
+        private float angle;
+        private int dir = 1;
+        private boolean reduced;
+        int alpha = 255;
+
+        Swinging(float density, float amplitude) {
+            this.density = density;
+            this.amplitude = amplitude;
+            animator = ValueAnimator.ofFloat(0f, 1f);
+            animator.setDuration(1100);
+            animator.setInterpolator(new LinearInterpolator());
+            animator.addUpdateListener(a -> {
+                float t = a.getAnimatedFraction() * 1.1f;
+                angle = dir * this.amplitude * (float) (Math.exp(-t / 0.32) * Math.sin(2 * Math.PI * 2.7 * t));
+                invalidateSelf();
+            });
+        }
+
+        void setReducedMotion(boolean reduced) {
+            this.reduced = reduced;
+        }
+
+        /** Swings it, the other way from last time. */
+        void swing() {
+            if (reduced) return;
+            dir = -dir;
+            animator.cancel();
+            animator.start();
+        }
+
+        abstract float pivotX();
+
+        abstract float pivotY();
+
+        /** Draws the icon in the 24 x 24 box. */
+        abstract void drawIcon(Canvas c);
+
+        @Override
+        public void draw(@NonNull Canvas c) {
+            Rect b = getBounds();
+            int save = c.save();
+            c.translate(b.left, b.top);
+            c.scale(b.width() / BOX, b.height() / BOX);
+            if (alpha < 255) c.saveLayerAlpha(0, 0, BOX, BOX, alpha);
+            c.rotate(angle, pivotX(), pivotY());
+            drawIcon(c);
+            c.restoreToCount(save);
+        }
+
+        @Override
+        public int getIntrinsicWidth() {
+            return Math.round(BOX * density);
+        }
+
+        @Override
+        public int getIntrinsicHeight() {
+            return Math.round(BOX * density);
+        }
+
+        @Override
+        public void setAlpha(int alpha) {
+            if (this.alpha == alpha) return;
+            this.alpha = alpha;
+            invalidateSelf();
+        }
+
+        @Override
+        public int getAlpha() {
+            return alpha;
+        }
+
+        @Override
+        public void setColorFilter(@Nullable ColorFilter filter) {
+            // the icons keep their own colours
+        }
+
+        @Override
+        public int getOpacity() {
+            return PixelFormat.TRANSLUCENT;
+        }
+    }
+
+    static Paint fill(int color) {
+        Paint p = new Paint(Paint.ANTI_ALIAS_FLAG);
+        p.setColor(color);
+        return p;
+    }
+
+    static Paint stroke(int color, float width) {
+        Paint p = new Paint(Paint.ANTI_ALIAS_FLAG);
+        p.setStyle(Paint.Style.STROKE);
+        p.setStrokeWidth(width);
+        p.setStrokeCap(Paint.Cap.ROUND);
+        p.setStrokeJoin(Paint.Join.ROUND);
+        p.setColor(color);
+        return p;
+    }
+
+    // ---- bell -------------------------------------------------------------------------------------
+
+    /** A gold bell under a red bow, lit from the top left. */
+    static final class Bell extends Swinging {
+        private final Path body = new Path(), loopL = new Path(), loopR = new Path(), tails = new Path();
+        private final Paint gold, goldEdge, lip, bow, bowEdge, clapper, shine;
+
+        Bell(float density) {
+            super(density, 15f);
+            body.moveTo(12f, 6.2f);
+            body.cubicTo(7.7f, 6.2f, 6.8f, 9.8f, 6.6f, 13f);
+            body.cubicTo(6.4f, 15.9f, 5.4f, 17.3f, 4.1f, 18.5f);
+            body.lineTo(19.9f, 18.5f);
+            body.cubicTo(18.6f, 17.3f, 17.6f, 15.9f, 17.4f, 13f);
+            body.cubicTo(17.2f, 9.8f, 16.3f, 6.2f, 12f, 6.2f);
+            body.close();
+            loopL.moveTo(12f, 4.6f);
+            loopL.cubicTo(10.4f, 2.0f, 6.6f, 1.6f, 6.6f, 3.9f);
+            loopL.cubicTo(6.6f, 5.9f, 10.0f, 5.6f, 12f, 4.6f);
+            loopL.close();
+            loopR.moveTo(12f, 4.6f);
+            loopR.cubicTo(13.6f, 2.0f, 17.4f, 1.6f, 17.4f, 3.9f);
+            loopR.cubicTo(17.4f, 5.9f, 14.0f, 5.6f, 12f, 4.6f);
+            loopR.close();
+            tails.moveTo(11.4f, 5f);
+            tails.lineTo(9.2f, 8.6f);
+            tails.lineTo(10.4f, 8.3f);
+            tails.lineTo(11.2f, 9.4f);
+            tails.lineTo(12f, 5.4f);
+            tails.lineTo(12.8f, 9.4f);
+            tails.lineTo(13.6f, 8.3f);
+            tails.lineTo(14.8f, 8.6f);
+            tails.lineTo(12.6f, 5f);
+            tails.close();
+
+            gold = new Paint(Paint.ANTI_ALIAS_FLAG);
+            gold.setShader(new LinearGradient(4f, 0f, 20f, 0f,
+                    new int[]{0xFF7A4E10, 0xFFD9A93E, 0xFFFFF2BE, 0xFFF0C252, 0xFFB07A1E, 0xFF6A440C},
+                    new float[]{0f, 0.2f, 0.36f, 0.55f, 0.82f, 1f}, Shader.TileMode.CLAMP));
+            goldEdge = stroke(0xFF5A3A08, 0.45f);
+            lip = new Paint(Paint.ANTI_ALIAS_FLAG);
+            lip.setShader(new LinearGradient(3.6f, 0f, 20.4f, 0f,
+                    new int[]{0xFF8A5A12, 0xFFF6D57A, 0xFFE2B044, 0xFF8A5A12}, null, Shader.TileMode.CLAMP));
+            bow = new Paint(Paint.ANTI_ALIAS_FLAG);
+            bow.setShader(new LinearGradient(0f, 1.5f, 0f, 9.5f, new int[]{0xFFF04050, 0xFFC8102E, 0xFF7E0A1C},
+                    null, Shader.TileMode.CLAMP));
+            bowEdge = stroke(0xFF5C0712, 0.35f);
+            clapper = new Paint(Paint.ANTI_ALIAS_FLAG);
+            clapper.setShader(new RadialGradient(11.4f, 20.6f, 2.2f, new int[]{0xFFFFF0B0, 0xFFC08A26, 0xFF6A440C},
+                    null, Shader.TileMode.CLAMP));
+            shine = fill(0x99FFFFFF);
+        }
+
+        @Override
+        float pivotX() {
+            return 12f;
+        }
+
+        @Override
+        float pivotY() {
+            return 4.4f;
+        }
+
+        @Override
+        void drawIcon(Canvas c) {
+            c.drawCircle(12f, 20.8f, 1.6f, clapper);
+            c.drawPath(body, gold);
+            c.drawPath(body, goldEdge);
+            c.drawRoundRect(3.7f, 18.1f, 20.3f, 20.0f, 0.9f, 0.9f, lip);
+            c.drawRoundRect(3.7f, 18.1f, 20.3f, 20.0f, 0.9f, 0.9f, goldEdge);
+            c.drawOval(8.2f, 8.4f, 9.6f, 13.4f, shine);
+            c.drawPath(tails, bow);
+            c.drawPath(tails, bowEdge);
+            c.drawPath(loopL, bow);
+            c.drawPath(loopL, bowEdge);
+            c.drawPath(loopR, bow);
+            c.drawPath(loopR, bowEdge);
+            c.drawCircle(12f, 4.6f, 1.25f, bow);
+            c.drawCircle(12f, 4.6f, 1.25f, bowEdge);
+        }
+    }
+
+    // ---- bauble -----------------------------------------------------------------------------------
+
+    /** A red glass bauble with a gold cap and a band of gold; grey while the TV is offline. */
+    static final class Bauble extends Swinging {
+        private final Paint ball, cap, capEdge, loop, band, shine, shine2, edge;
+        private final Path bandPath = new Path();
+        private final ColorMatrixColorFilter grey;
+        private boolean online = true;
+
+        Bauble(float density) {
+            super(density, 12f);
+            ball = new Paint(Paint.ANTI_ALIAS_FLAG);
+            ball.setShader(new RadialGradient(9.2f, 10.4f, 11.5f,
+                    new int[]{0xFFFF8A98, 0xFFE3233F, 0xFF9C0B26, 0xFF4A0611},
+                    new float[]{0f, 0.32f, 0.72f, 1f}, Shader.TileMode.CLAMP));
+            edge = stroke(0x66330408, 0.4f);
+            cap = new Paint(Paint.ANTI_ALIAS_FLAG);
+            cap.setShader(new LinearGradient(9.8f, 0f, 14.2f, 0f,
+                    new int[]{0xFF8A5A12, 0xFFFFE9A6, 0xFFD9A43A, 0xFF7A4E10}, null, Shader.TileMode.CLAMP));
+            capEdge = stroke(0xFF5A3A08, 0.35f);
+            loop = stroke(0xFFD9A43A, 0.75f);
+            band = stroke(0xDDF2C75C, 0.9f);
+            bandPath.moveTo(3.6f, 13.4f);
+            bandPath.quadTo(12f, 17.2f, 20.4f, 13.4f);
+            shine = fill(0xC8FFFFFF);
+            shine2 = fill(0x80FFFFFF);
+            ColorMatrix m = new ColorMatrix();
+            m.setSaturation(0f);
+            grey = new ColorMatrixColorFilter(m);
+        }
+
+        /** Grey and dimmer while offline. */
+        void setOnline(boolean online) {
+            if (this.online == online) return;
+            this.online = online;
+            ColorFilter f = online ? null : grey;
+            for (Paint p : new Paint[]{ball, cap, loop, band}) p.setColorFilter(f);
+            invalidateSelf();
+        }
+
+        @Override
+        float pivotX() {
+            return 12f;
+        }
+
+        @Override
+        float pivotY() {
+            return 1.2f;
+        }
+
+        @Override
+        void drawIcon(Canvas c) {
+            c.drawCircle(12f, 2.4f, 1.15f, loop);
+            c.drawCircle(12f, 14.2f, 8.6f, ball);
+            c.drawCircle(12f, 14.2f, 8.6f, edge);
+            c.save();
+            c.clipRect(3f, 5f, 21f, 23f);
+            c.drawPath(bandPath, band);
+            c.restore();
+            c.save();
+            c.rotate(-35f, 8.8f, 10.4f);
+            c.drawOval(6.2f, 9.3f, 11.4f, 11.6f, shine);
+            c.restore();
+            c.drawCircle(15.6f, 18.4f, 0.7f, shine2);
+            c.drawRoundRect(9.9f, 3.3f, 14.1f, 6.0f, 0.6f, 0.6f, cap);
+            c.drawRoundRect(9.9f, 3.3f, 14.1f, 6.0f, 0.6f, 0.6f, capEdge);
+        }
+    }
+
+    // ---- snowflake --------------------------------------------------------------------------------
+
+    /** Draws a six-armed snowflake with side branches at (cx, cy), arms r long, in the current paint. */
+    static void snowflake(Canvas c, float cx, float cy, float r, Paint line) {
+        for (int k = 0; k < 6; k++) {
+            double a = Math.PI / 3 * k - Math.PI / 2;
+            float ux = (float) Math.cos(a), uy = (float) Math.sin(a);
+            c.drawLine(cx, cy, cx + ux * r, cy + uy * r, line);
+            float[][] branches = {{0.42f, 0.30f}, {0.68f, 0.22f}};
+            for (float[] br : branches) {
+                float bx = cx + ux * r * br[0], by = cy + uy * r * br[0];
+                for (int s = -1; s <= 1; s += 2) {
+                    double b = a + s * Math.toRadians(58);
+                    c.drawLine(bx, by, bx + (float) Math.cos(b) * r * br[1], by + (float) Math.sin(b) * r * br[1], line);
+                }
+            }
+        }
+    }
+
+    /** An icy snowflake; {@link #turn()} turns it a sixth of a circle. */
+    static final class Snowflake extends Drawable {
+        private static final float BOX = 24f;
+        private final float density;
+        private final Paint halo, line, glint;
+        private final ValueAnimator animator;
+        private float rotation, from, target;
+        private boolean reduced;
+        private int alpha = 255;
+
+        Snowflake(float density) {
+            this.density = density;
+            halo = stroke(0x995FA8E8, 2.3f);
+            line = stroke(0xFFF2FAFF, 1.15f);
+            glint = new Paint(Paint.ANTI_ALIAS_FLAG);
+            glint.setShader(new RadialGradient(12f, 12f, 4.2f, new int[]{0xCCFFFFFF, 0x55CFE8FF, 0x00CFE8FF}, null,
+                    Shader.TileMode.CLAMP));
+            animator = ValueAnimator.ofFloat(0f, 1f);
+            animator.setDuration(900);
+            animator.setInterpolator(new DecelerateInterpolator(1.6f));
+            animator.addUpdateListener(a -> {
+                rotation = from + (target - from) * (float) a.getAnimatedValue();
+                invalidateSelf();
+            });
+        }
+
+        void setReducedMotion(boolean reduced) {
+            this.reduced = reduced;
+        }
+
+        void turn() {
+            if (reduced) return;
+            from = rotation;
+            target = target + 60f;
+            animator.cancel();
+            animator.start();
+        }
+
+        @Override
+        public void draw(@NonNull Canvas c) {
+            Rect b = getBounds();
+            int save = c.save();
+            c.translate(b.left, b.top);
+            c.scale(b.width() / BOX, b.height() / BOX);
+            if (alpha < 255) c.saveLayerAlpha(0, 0, BOX, BOX, alpha);
+            c.rotate(rotation, 12f, 12f);
+            snowflake(c, 12f, 12f, 10.2f, halo);
+            snowflake(c, 12f, 12f, 10.2f, line);
+            c.drawCircle(12f, 12f, 4.2f, glint);
+            c.restoreToCount(save);
+        }
+
+        @Override
+        public int getIntrinsicWidth() {
+            return Math.round(BOX * density);
+        }
+
+        @Override
+        public int getIntrinsicHeight() {
+            return Math.round(BOX * density);
+        }
+
+        @Override
+        public void setAlpha(int alpha) {
+            if (this.alpha == alpha) return;
+            this.alpha = alpha;
+            invalidateSelf();
+        }
+
+        @Override
+        public int getAlpha() {
+            return alpha;
+        }
+
+        @Override
+        public void setColorFilter(@Nullable ColorFilter filter) {
+            // keeps its own colours
+        }
+
+        @Override
+        public int getOpacity() {
+            return PixelFormat.TRANSLUCENT;
+        }
+    }
+
+    // ---- knitted pill (Ugly Sweater Day) -----------------------------------------------------------
+
+    /**
+     * A pill knitted in red wool: rows of little V stitches, a white sawtooth border top and bottom and a row of
+     * white diamonds between them. Focused, the colours swap (cream wool, red pattern) so dark focus text reads.
+     */
+    static final class KnitPill extends Drawable {
+        private final float d;
+        private final Paint wool = new Paint(Paint.ANTI_ALIAS_FLAG), stitch, motif = new Paint(Paint.ANTI_ALIAS_FLAG),
+                rim;
+        private final Path clip = new Path(), saw = new Path(), diamonds = new Path(), stitches = new Path();
+        private final RectF r = new RectF();
+        private boolean focused;
+        private int alpha = 255;
+
+        KnitPill(float density) {
+            d = density;
+            stitch = stroke(0, 0.7f * density);
+            rim = stroke(0, 1.5f * density);
+            rim.setStrokeCap(Paint.Cap.BUTT);
+        }
+
+        @Override
+        protected void onBoundsChange(@NonNull Rect b) {
+            super.onBoundsChange(b);
+            r.set(b);
+            float h = r.height(), rad = h / 2f;
+            clip.reset();
+            clip.addRoundRect(r, rad, rad, Path.Direction.CW);
+            float step = 5f * d, row = 5f * d;
+            stitches.reset();
+            for (float y = r.top + row * 0.6f; y < r.bottom; y += row) {
+                for (float x = r.left + step * 0.5f; x < r.right; x += step) {
+                    stitches.moveTo(x - step * 0.32f, y - row * 0.3f);
+                    stitches.lineTo(x, y + row * 0.18f);
+                    stitches.lineTo(x + step * 0.32f, y - row * 0.3f);
+                }
+            }
+            saw.reset();
+            float tooth = 6f * d;
+            for (int edge = 0; edge < 2; edge++) {
+                float base = edge == 0 ? r.top + h * 0.2f : r.bottom - h * 0.2f;
+                float tip = edge == 0 ? base - h * 0.1f : base + h * 0.1f;
+                saw.moveTo(r.left, base);
+                for (float x = r.left; x < r.right; x += tooth) {
+                    saw.lineTo(x + tooth / 2f, tip);
+                    saw.lineTo(x + tooth, base);
+                }
+                saw.lineTo(r.right, edge == 0 ? r.top : r.bottom);
+                saw.lineTo(r.left, edge == 0 ? r.top : r.bottom);
+                saw.close();
+            }
+            diamonds.reset();   // a row of dots in each border band, clear of the text
+            float gap = 9f * d, dot = 0.9f * d;
+            for (int edge = 0; edge < 2; edge++) {
+                float y = edge == 0 ? r.top + h * 0.075f : r.bottom - h * 0.075f;
+                for (float x = r.left + rad * 0.7f; x < r.right - rad * 0.7f; x += gap) {
+                    diamonds.addCircle(x, y, dot, Path.Direction.CW);
+                }
+            }
+        }
+
+        @Override
+        public boolean isStateful() {
+            return true;
+        }
+
+        @Override
+        protected boolean onStateChange(@NonNull int[] state) {
+            boolean f = false;
+            for (int s : state) if (s == android.R.attr.state_focused) f = true;
+            if (f == focused) return false;
+            focused = f;
+            invalidateSelf();
+            return true;
+        }
+
+        @Override
+        public void draw(@NonNull Canvas c) {
+            if (r.isEmpty()) return;
+            int save = c.save();
+            if (alpha < 255) c.saveLayerAlpha(r, alpha);
+            c.clipPath(clip);
+            wool.setColor(focused ? 0xFFF7ECDA : 0xFFAE1530);
+            c.drawRect(r, wool);
+            stitch.setColor(focused ? 0xFFEDE0CB : 0xFF9C1128);
+            c.drawPath(stitches, stitch);
+            motif.setColor(focused ? 0xFFAE1530 : 0xFFF7F2EA);
+            c.drawPath(saw, motif);
+            c.drawPath(diamonds, motif);
+            c.restoreToCount(save);
+            rim.setColor(focused ? 0xFFFFFFFF : 0x80FFFFFF);
+            rim.setStrokeWidth((focused ? 2.5f : 1.5f) * d);
+            float inset = rim.getStrokeWidth() / 2f;
+            c.drawRoundRect(r.left + inset, r.top + inset, r.right - inset, r.bottom - inset,
+                    r.height() / 2f - inset, r.height() / 2f - inset, rim);
+        }
+
+        @Override
+        public void setAlpha(int alpha) {
+            this.alpha = alpha;
+            invalidateSelf();
+        }
+
+        @Override
+        public int getAlpha() {
+            return alpha;
+        }
+
+        @Override
+        public void setColorFilter(@Nullable ColorFilter filter) {
+        }
+
+        @Override
+        public int getOpacity() {
+            return PixelFormat.TRANSLUCENT;
+        }
+    }
+}
