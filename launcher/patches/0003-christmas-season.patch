+
+    // ---- focus: the gnome hops away, snow falls off tiles -------------------------------------------
+
+    void onFocus(View focused) {
+        int position = -1;
+        if (focused != null && grid != null) {
+            View item = focused;
+            while (item != null && item.getParent() != grid) {
+                item = item.getParent() instanceof View ? (View) item.getParent() : null;
+            }
+            if (item != null) position = grid.getChildAdapterPosition(item);
+        }
+        if (caps != null) caps.setFocused(position >= 0 && position < columns ? position : -1);
+        if (gnome == null || !gnomeShown || gnomeHopping) return;
+        if (position >= 0 && gnomeSpot.equals("tile:" + position)) {
+            int next = position + 1 < columns ? position + 1 : position - 1;
+            if (next >= 0) hop("tile:" + next);
+            return;
+        }
+        String[] pills = {"inputs", "wifi", "settings"};
+        for (int i = 0; i < pills.length; i++) {
+            if (focused != null && focused == pill(pills[i]) && gnomeSpot.equals("pill:" + pills[i])) {
+                hop("pill:" + pills[i == pills.length - 1 ? i - 1 : i + 1]);
+                return;
+            }
+        }
+    }
+
+    private void hop(String to) {
+        PointF target = seat(to);
+        if (target == null) return;
