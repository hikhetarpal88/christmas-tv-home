+            case "shooting_star":
+                playMoment(new HolidayMoments.ShootingStar(activity, 2, day.toEpochDay()), 2200, null);
+                return true;
+            case "sleigh": {
+                PointF moonAt = sky != null ? sky.moonCentre() : null;
+                playMoment(new HolidayMoments.Sleigh(activity, moonAt != null, moonAt), 4200, null);
+                return true;
+            }
+            case "chase":
+                if (lights == null) return false;
+                playMoment(new HolidayMoments.Chase(activity, lights), 2600, null);
+                return true;
+            case "snowflake":
+                playMoment(new HolidayMoments.GiantFlake(activity, w * 0.6f, h * 0.36f), 3600, null);
+                return true;
+            case "aurora":
+                playMoment(new HolidayMoments.Aurora(activity), 5000, null);
+                return true;
+            case "ornament": {
+                if (tree == null) return false;
+                int index = ornaments(day) - 1;
+                if (index < 0) return false;
+                float[] s = tree.ornamentSpot(index);
+                playMoment(new HolidayMoments.OrnamentDrop(activity, treeBox.getX() + s[0], treeBox.getY() + s[1], s[2],
