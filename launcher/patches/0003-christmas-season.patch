+            case "presents":
+                if (tree == null) return false;
+                playMoment(new HolidayMoments.PresentsDrop(activity, treeBox.getX() + treeBox.getWidth() / 2f,
+                        treeBox.getY() + treeBox.getHeight()), 1600, () -> settle("presents"));
