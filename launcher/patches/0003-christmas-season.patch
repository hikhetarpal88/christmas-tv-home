+    // ---- greeting and weather -----------------------------------------------------------------------
+
+    /** The greeting for now: the Santa tracker on Christmas Eve, a note when it's really snowing, else base. */
+    String greeting(String base) {
+        if (hasWord(plan.style, "santa")) return santa(Instant.now());
+        if (snowing) return base.isEmpty() ? "It's snowing!" : "It's snowing · " + base;
+        return base;
