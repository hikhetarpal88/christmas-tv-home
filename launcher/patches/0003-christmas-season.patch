+
+    /** bravia_weather's text ("2° SNOW"): heavier snow while it snows outside, frost in the corners below zero. */
+    void onWeather(String text) {
+        String t = text == null ? "" : text.toLowerCase(Locale.ROOT);
+        boolean s = t.contains("snow");
+        boolean c = false;
+        int deg = t.indexOf('°');
+        if (deg > 0) {
+            try {
+                c = Integer.parseInt(t.substring(0, deg).trim()) <= 0;
+            } catch (NumberFormatException ignored) {
+                // no temperature: no frost
+            }
+        }
+        if (s != snowing) {
+            snowing = s;
+            if (snow != null) snow.setHeavy(s);
+        }
+        if (c != cold) {
+            cold = c;
+            if (frost != null) frost.setVisibility(c ? View.VISIBLE : View.GONE);
+        }
+    }
+
+    /**
+     * Christmas Eve: where Santa is, worked out on the TV. He sets off when it's midnight on the 25th somewhere
+     * (Kiribati, 10:00 UTC on the 24th) and is wherever midnight has most recently arrived (December offsets).
+     * He's "here" once midnight reaches the TV's own time zone, and nearly here in the hour before.
+     */
+    static String santa(Instant now) {
+        return santa(now, ZoneId.systemDefault().getRules().getOffset(now).getTotalSeconds() / 60);
+    }
+
+    /** As above, for a TV whose clock is {@code here} minutes east of UTC. */
+    static String santa(Instant now, int here) {
+        ZonedDateTime utc = now.atZone(ZoneOffset.UTC);
+        int year = utc.getMonthValue() == 1 ? utc.getYear() - 1 : utc.getYear();
+        long minutes = Duration.between(ZonedDateTime.of(year, 12, 25, 0, 0, 0, 0, ZoneOffset.UTC), utc).toMinutes();
+        // Midnight has passed everywhere east of (offset >= -minutes).
+        int threshold = (int) -minutes;
+        Object[][] places = {
+                {840, "Kiribati"}, {780, "New Zealand"}, {720, "Fiji"}, {660, "Sydney"}, {600, "Brisbane"},
+                {540, "Tokyo"}, {480, "Singapore"}, {420, "Bangkok"}, {360, "Dhaka"}, {345, "Nepal"},
+                {330, "India"}, {300, "Pakistan"}, {240, "Dubai"}, {180, "Nairobi"}, {120, "Cairo"}, {60, "Paris"},
+                {0, "London"}, {-60, "Cape Verde"}, {-180, "Rio"}, {-210, "Newfoundland"}, {-240, "Halifax"},
+                {-300, "New York"}, {-360, "Chicago"}, {-420, "Denver"}, {-480, "Los Angeles"},
+                {-540, "Alaska"}, {-600, "Hawaii"}, {-660, "Samoa"},
+        };
+        if (threshold > 840) return "Santa's packing the sleigh";
+        if (here >= threshold) return "Santa's here. Off to bed!";
+        if (here >= threshold - 60) return "Santa's nearly here. Bedtime!";
+        String where = "Kiribati";
+        for (Object[] p : places) {
+            if ((int) p[0] >= threshold) where = (String) p[1];
+        }
+        return "Santa's over " + where;
+    }
+
+    // ---- snowfall ---------------------------------------------------------------------------------
+
+    /**
+     * Snow in two depths, small far flakes and larger near ones, all behind Home's text and tiles. Each flake is a
+     * view with a glow bitmap; one TimeAnimator moves them all as view properties (no redraws). Extra flakes wait
+     * hidden for real snow.
+     */
+    private final class Snow {
+        private final List<View> flakes = new ArrayList<>();
+        private float[] x0 = new float[0], y0 = new float[0], v = new float[0], amp = new float[0],
+                per = new float[0], ph = new float[0], size = new float[0];
+        private boolean[] heavyOnly = new boolean[0];
+        private final TimeAnimator clock = new TimeAnimator();
+        private final int insertAt;
+        final int behindCount;
+        private boolean heavy;
+        private final Random rnd = new Random(0x5110L);
+
+        Snow(int insertAt) {
+            this.insertAt = insertAt;
+            int at = insertAt;
+            at = add(at, 26, 2.2f, 4.2f, 22, 34, 0.5f, 0.8f, false);
+            at = add(at, 12, 4.8f, 8f, 38, 58, 0.72f, 0.92f, false);
+            at = add(at, 22, 2.4f, 6f, 40, 70, 0.6f, 0.9f, true);
+            behindCount = at - insertAt;
+            clock.setTimeListener((animation, total, delta) -> frame(total / 1000f));
+        }
+
+        /** Adds n flakes of a size range (dp) and speed range (dp/s); returns the next insert index. */
+        private int add(int at, int n, float s0, float s1, float v0, float v1, float a0, float a1, boolean extra) {
+            int base = flakes.size();
+            x0 = Arrays.copyOf(x0, base + n);
+            y0 = Arrays.copyOf(y0, base + n);
+            v = Arrays.copyOf(v, base + n);
+            amp = Arrays.copyOf(amp, base + n);
+            per = Arrays.copyOf(per, base + n);
+            ph = Arrays.copyOf(ph, base + n);
+            size = Arrays.copyOf(size, base + n);
+            heavyOnly = Arrays.copyOf(heavyOnly, base + n);
+            for (int i = 0; i < n; i++) {
+                int k = base + i;
+                float s = (s0 + rnd.nextFloat() * (s1 - s0)) * d;
+                int px = Math.max(2, Math.round(s * (s1 > 20 ? 1f : 2.6f)));
+                View f = new View(activity);
+                Bitmap g = HolidayArt.glow(px, 0xFFEAF4FF, s1 > 20 ? 0.55f : 0.32f);
+                f.setBackground(new BitmapDrawable(activity.getResources(), g));
+                HolidayArt.quiet(f);
+                f.setAlpha(a0 + rnd.nextFloat() * (a1 - a0));
+                FrameLayout.LayoutParams lp = new FrameLayout.LayoutParams(px, px, Gravity.TOP | Gravity.LEFT);
+                if (at < 0) root.addView(f, lp);
+                else root.addView(f, at++, lp);
+                if (extra) f.setVisibility(View.GONE);
+                flakes.add(f);
+                x0[k] = rnd.nextFloat() * screenW;
+                y0[k] = rnd.nextFloat() * (screenH + px);
+                v[k] = (v0 + rnd.nextFloat() * (v1 - v0)) * d;
+                amp[k] = (6 + rnd.nextFloat() * 18) * d * (s1 > 20 ? 2f : 1f);
+                per[k] = 4f + rnd.nextFloat() * 4f;
+                ph[k] = rnd.nextFloat() * 6.283f;
+                size[k] = px;
+                heavyOnly[k] = extra;
+            }
+            return at;
+        }
+
+        void setHeavy(boolean on) {
+            heavy = on;
+            for (int i = 0; i < flakes.size(); i++) {
+                if (heavyOnly[i]) flakes.get(i).setVisibility(on ? View.VISIBLE : View.GONE);
+            }
+        }
+
+        void frame(float t) {
+            float speed = heavy ? 1.35f : 1f;
+            for (int i = 0; i < flakes.size(); i++) {
+                View f = flakes.get(i);
+                if (f.getVisibility() != View.VISIBLE) continue;
+                float range = screenH + 2 * size[i];
+                float y = (y0[i] + v[i] * speed * t) % range - size[i];
+                float x = x0[i] + amp[i] * (float) Math.sin(6.2832f * t / per[i] + ph[i]);
+                f.setTranslationX(x - size[i] / 2f);
+                f.setTranslationY(y);
+            }
+        }
+
+        void start() {
+            if (clock.isPaused()) clock.resume();
+            else if (!clock.isStarted()) clock.start();
+        }
+
+        void stop() {
+            if (clock.isStarted()) clock.pause();
+        }
+    }
+
+    // ---- snow on the dock's tiles -------------------------------------------------------------------
+
+    /**
+     * A cap of snow on each dock tile. Landing on a tile knocks its snow off (it slides away and breaks up); the
+     * snow builds back over a minute and a half once you've moved on.
+     */
+    private final class SnowCaps extends RecyclerView.ItemDecoration {
+        private static final long FALL_MS = 650, REGROW_DELAY_MS = 5000, REGROW_MS = 90_000;
+        private final float[] knockedAt = new float[32];
+        private final long[] fellAt = new long[32], leftAt = new long[32];
+        private final float[][] bumps = new float[32][];
+        private final Paint cap = new Paint(Paint.ANTI_ALIAS_FLAG), shadow = new Paint(Paint.ANTI_ALIAS_FLAG),
+                chunk = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private final Path path = new Path();
+        private final android.graphics.Matrix shift = new android.graphics.Matrix();
+        private LinearGradient snowShade;
+        private final float capH;
+        private int focused = -1;
+        private boolean running;
+        private final Runnable regrow = new Runnable() {
+            @Override
+            public void run() {
+                if (!running) return;
+                if (anyGrowing()) grid.invalidate();
+                handler.postDelayed(this, 3000);
+            }
+        };
+
+        SnowCaps() {
+            capH = 12 * d;
+            Random rnd = new Random(0xCA95L);
+            for (int i = 0; i < bumps.length; i++) {
+                int n = 7 + rnd.nextInt(3);
+                bumps[i] = new float[n];
+                for (int k = 0; k < n; k++) bumps[i][k] = 0.02f + rnd.nextFloat() * 0.62f;
+            }
+            Arrays.fill(knockedAt, 0f);
+            snowShade = new LinearGradient(0, 0, 0, capH * 1.5f, new int[]{0xFFFFFFFF, 0xFFF1F5FA, 0xFFCFDBE8},
+                    new float[]{0f, 0.55f, 1f}, Shader.TileMode.CLAMP);
+            cap.setShader(snowShade);
+            shadow.setColor(0x38000000);
+            chunk.setColor(0xFFF2F6FB);
+        }
+
+        void resume() {
+            running = true;
+            handler.removeCallbacks(regrow);
+            handler.postDelayed(regrow, 3000);
+        }
+
+        void pause() {
+            running = false;
+            handler.removeCallbacks(regrow);
+        }
+
+        void setFocused(int position) {
+            if (position == focused) return;
+            long now = SystemClock.uptimeMillis();
+            if (focused >= 0 && focused < leftAt.length) leftAt[focused] = now;
+            float had = position >= 0 && position < fellAt.length ? level(position, now) : 0f;
+            focused = position;
+            if (had > 0.05f && !reduced) {
+                fellAt[position] = now;
+                knockedAt[position] = had;
+                grid.postInvalidateOnAnimation();
+            }
+            grid.invalidate();
+        }
+
+        /** How much snow tile i carries now, 0 to 1. */
+        private float level(int i, long now) {
+            if (i == focused) return 0f;
+            if (leftAt[i] == 0) return 1f;
+            float t = (now - leftAt[i] - REGROW_DELAY_MS) / (float) REGROW_MS;
+            return Math.max(0f, Math.min(1f, t));
+        }
+
+        private boolean anyGrowing() {
+            long now = SystemClock.uptimeMillis();
+            for (int i = 0; i < columns && i < leftAt.length; i++) {
+                if (i != focused && leftAt[i] != 0 && level(i, now) < 1f) return true;
+            }
+            return false;
+        }
+
+        @Override
+        public void onDrawOver(@NonNull Canvas c, @NonNull RecyclerView parent, @NonNull RecyclerView.State state) {
+            long now = SystemClock.uptimeMillis();
+            boolean animating = false;
+            for (int k = 0; k < parent.getChildCount(); k++) {
+                View child = parent.getChildAt(k);
+                int pos = parent.getChildAdapterPosition(child);
+                if (pos < 0 || pos >= columns || pos >= bumps.length) continue;
+                View card = child.findViewById(R.id.card);
+                if (card == null || card.getWidth() == 0) continue;
+                float w = card.getWidth() * card.getScaleX(), h = card.getHeight() * card.getScaleY();
+                float cx = child.getLeft() + child.getTranslationX() + card.getLeft() + card.getWidth() / 2f;
+                float cy = child.getTop() + child.getTranslationY() + card.getTop() + card.getHeight() / 2f;
+                float left = cx - w / 2f, top = cy - h / 2f;
+                float lv = level(pos, now);
+                if (lv > 0.02f) drawCap(c, left, top, w, lv, pos, 0f, 255);
+                long since = now - fellAt[pos];
+                if (fellAt[pos] != 0 && since < FALL_MS) {
+                    animating = true;
+                    float t = since / (float) FALL_MS;
+                    int save = c.save();
+                    c.rotate((pos % 2 == 0 ? 7f : -7f) * t, left + w / 2f, top);
+                    drawCap(c, left, top, w, knockedAt[pos], pos, d * 46f * t * t, Math.round(255 * (1f - t)));
+                    c.restoreToCount(save);
+                    for (int j = 0; j < 7; j++) {
+                        float jx = left + w * (0.12f + 0.12f * j), jy = top + d * (10 + 70 * t * t) + d * 4 * (j % 3);
+                        chunk.setAlpha(Math.round(230 * (1f - t)));
+                        c.drawCircle(jx + d * 6 * (j % 2 == 0 ? t : -t), jy, d * (1.6f + (j % 3)), chunk);
+                    }
+                }
+            }
+            if (animating) parent.postInvalidateOnAnimation();
+        }
+
+        private void drawCap(Canvas c, float left, float top, float w, float level, int pos, float drop, int alpha) {
+            float hgt = capH * (0.35f + 0.65f * level);
+            float[] b = bumps[pos];
+            float y0 = top + d * 2.5f + drop;
+            path.reset();
+            path.moveTo(left - d * 2.5f, y0);
+            int n = b.length;
+            float prevX = left - d * 2.5f, prevY = y0 - hgt * 0.3f;
+            path.lineTo(prevX, prevY);
+            for (int i = 0; i < n; i++) {
+                float x = left + w * (i + 0.5f) / n;
+                float y = y0 - hgt * (0.62f + b[i]);
+                float mx = (prevX + x) / 2f, my = (prevY + y) / 2f;
+                path.quadTo(prevX, prevY, mx, my);
+                prevX = x;
+                prevY = y;
+            }
+            float endX = left + w + d * 2.5f, endY = y0 - hgt * 0.3f;
+            path.quadTo(prevX, prevY, endX, endY);
+            path.lineTo(endX, y0);
+            // a soft lip with two small drips over the tile's face
+            path.quadTo(left + w * 0.86f, y0 + d * 1.5f, left + w * 0.8f, y0 + d * 1.2f);
+            path.quadTo(left + w * 0.78f, y0 + d * 5f * level, left + w * 0.76f, y0 + d * 1.2f);
+            path.lineTo(left + w * 0.3f, y0 + d * 1.6f);
+            path.quadTo(left + w * 0.28f, y0 + d * 4f * level, left + w * 0.26f, y0 + d * 1.6f);
+            path.quadTo(left + w * 0.1f, y0 + d * 1.8f, left - d * 2.5f, y0);
+            path.close();
+            shadow.setAlpha(Math.round(56 * alpha / 255f));
+            c.save();
+            c.translate(0, d * 1.6f);
+            c.drawPath(path, shadow);
+            c.restore();
+            cap.setAlpha(alpha);
+            shift.setTranslate(0, y0 - hgt * 1.05f);
+            snowShade.setLocalMatrix(shift);
+            c.drawPath(path, cap);
+        }
+    }
+}
