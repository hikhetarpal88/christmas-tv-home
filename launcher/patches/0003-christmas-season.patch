+            for (float[] k : corners) {
+                mist.setShader(new RadialGradient(k[0], k[1], dp(190), new int[]{0x40DCEBFF, 0x14DCEBFF, 0x00DCEBFF},
+                        null, Shader.TileMode.CLAMP));
+                c.drawCircle(k[0], k[1], dp(190), mist);
+                for (int i = 0; i < 9; i++) {
+                    double a = Math.toRadians(5 + 80 * rnd.nextFloat());
+                    branch(c, k[0], k[1], (float) Math.cos(a) * k[2], (float) Math.sin(a) * k[3], dp(70 + rnd.nextInt(90)),
+                            3, rnd);
+                }
+            }
+        }
+
+        private void branch(Canvas c, float x, float y, float ux, float uy, float len, int depth, Random rnd) {
+            float ex = x + ux * len, ey = y + uy * len;
+            line.setStrokeWidth(dp(0.5f + depth * 0.35f));
+            line.setAlpha(40 + depth * 28);
+            c.drawLine(x, y, ex, ey, line);
+            if (depth == 0) return;
+            int kids = 3 + rnd.nextInt(3);
+            for (int i = 1; i <= kids; i++) {
+                float t = i / (float) (kids + 1);
+                float bx = x + ux * len * t, by = y + uy * len * t;
+                double a = Math.atan2(uy, ux) + (i % 2 == 0 ? 1 : -1) * Math.toRadians(50 + rnd.nextInt(20));
+                branch(c, bx, by, (float) Math.cos(a), (float) Math.sin(a), len * (0.32f + rnd.nextFloat() * 0.18f),
+                        depth - 1, rnd);
+            }
+        }
+    }
+}
