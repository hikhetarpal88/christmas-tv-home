+        float x0 = gnome.getX(), y0 = gnome.getY();
+        float x1 = target.x - gnome.getWidth() / 2f, y1 = target.y - gnome.anchorY();
+        if (reduced) {
+            gnome.setX(x1);
+            gnome.setY(y1);
+            return;
+        }
+        gnomeHopping = true;
+        ValueAnimator a = ValueAnimator.ofFloat(0f, 1f);
+        a.setDuration(560);
+        a.addUpdateListener(v -> {
+            float t = (float) v.getAnimatedValue();
+            gnome.setX(x0 + (x1 - x0) * t);
+            gnome.setY(y0 + (y1 - y0) * t - dpi(46) * (float) Math.sin(Math.PI * t));
+            gnome.setRotation((x1 > x0 ? 1 : -1) * 14f * (float) Math.sin(Math.PI * t));
+        });
+        a.addListener(new AnimatorListenerAdapter() {
+            @Override
+            public void onAnimationEnd(Animator animation) {
+                gnomeHopping = false;
+                gnome.setRotation(0f);
+                gnome.setPivotY(gnome.getHeight());
+                gnome.setScaleY(0.86f);
+                gnome.animate().scaleY(1f).setDuration(220).setInterpolator(new OvershootInterpolator(3f)).start();
+            }
+        });
+        a.start();
+    }
+
+    // ---- moments ----------------------------------------------------------------------------------
+
+    /** The first time Home opens today: the day's moments, one after another. */
+    void firstVisit() {
+        place();
+        if (!pendingFirst || activity.isFinishing()) {
+            revealQuiet();
+            return;
+        }
+        // Only when Home really has the screen: resumed under the screensaver or the TV's screen-off overlay, the
+        // moment waits for the next time Home takes focus instead of playing to nobody.
+        if (!started || !activity.hasWindowFocus()) return;
+        pendingFirst = false;
+        activity.getSharedPreferences(PREFS, Context.MODE_PRIVATE).edit().putString(LAST_MOMENT, momentKey()).apply();
