+import android.graphics.Shader;
+import android.view.View;
+import android.view.animation.LinearInterpolator;
+
+import java.util.List;
+import java.util.Random;
+
+/**
+ * bravia: the Christmas season's moments, each a few seconds long, played over Home the first time it opens on a
+ * day (HolidayDecor picks which from festival_calendar). A moment is a full-screen overlay redrawn every frame
+ * while it plays and removed when it ends, so it costs nothing afterwards. hold(f) draws one frame and keeps it,
+ * for screenshots (festival_preview_moment).
+ */
+final class HolidayMoments {
+    private HolidayMoments() {
+    }
+
+    abstract static class Moment extends View {
+        final float d;
+        float f;
+        private ValueAnimator anim;
+        private Runnable done;
+        private boolean finished;
+
+        Moment(Context c) {
+            super(c);
+            d = c.getResources().getDisplayMetrics().density;
+            HolidayArt.quiet(this);
+            setWillNotDraw(false);
+        }
+
+        float dp(float v) {
+            return v * d;
+        }
+
+        /** Plays over ms, then runs onDone (once). */
+        void play(long ms, Runnable onDone) {
+            done = onDone;
+            anim = ValueAnimator.ofFloat(0f, 1f);
+            anim.setDuration(ms);
+            anim.setInterpolator(new LinearInterpolator());
+            anim.addUpdateListener(a -> {
+                f = (float) a.getAnimatedValue();
+                invalidate();
+            });
+            anim.addListener(new AnimatorListenerAdapter() {
+                @Override
+                public void onAnimationEnd(Animator a) {
+                    finish();
+                }
+            });
+            onStart();
+            anim.start();
+        }
+
+        /** Shows the frame at f and stays there. */
+        void hold(float at) {
+            f = Math.max(0f, Math.min(1f, at));
+            onStart();
+            invalidate();
+        }
+
+        /** Jumps to the end (a key was pressed): whatever the moment leaves behind is put in place at once. */
+        void finishNow() {
+            if (anim != null) anim.end();
+            else finish();
+        }
+
+        private void finish() {
+            if (finished) return;
+            finished = true;
+            Runnable r = done;
+            done = null;
+            if (r != null) r.run();
+        }
+
+        void onStart() {
+        }
+
+        /** 0 to 1 over [a, b] of the moment, eased in and out. */
+        static float span(float f, float a, float b) {
+            float t = Math.max(0f, Math.min(1f, (f - a) / (b - a)));
+            return t * t * (3 - 2 * t);
+        }
+
+        @Override
+        protected void onDraw(Canvas c) {
+            frame(c, f);
+        }
+
+        abstract void frame(Canvas c, float f);
+    }
+
+    // ---- flurry -----------------------------------------------------------------------------------
+
+    /** A burst of snow from the top: the day's first flurry, or the snow globe shaken with Back. */
+    static final class Flurry extends Moment {
+        private final int n;
+        private final float[] x0, y0, v, s, a, ph;
+        private final Paint p = new Paint(Paint.FILTER_BITMAP_FLAG);
+        private final RectF r = new RectF();
+        private final float wind;
+
+        Flurry(Context c, int count, long seed, float wind) {
+            super(c);
+            n = count;
+            this.wind = wind;
+            x0 = new float[n];
+            y0 = new float[n];
+            v = new float[n];
+            s = new float[n];
+            a = new float[n];
+            ph = new float[n];
+            Random rnd = new Random(seed);
+            for (int i = 0; i < n; i++) {
+                x0[i] = rnd.nextFloat() * 1.2f - 0.1f;
+                y0[i] = -rnd.nextFloat() * 0.45f;
+                v[i] = 0.9f + rnd.nextFloat() * 0.8f;
+                s[i] = 1.5f + rnd.nextFloat() * (rnd.nextInt(6) == 0 ? 5f : 2.6f);
+                a[i] = 0.55f + rnd.nextFloat() * 0.45f;
+                ph[i] = rnd.nextFloat() * 6.28f;
+            }
+        }
+
+        @Override
+        void frame(Canvas c, float f) {
+            int w = getWidth(), h = getHeight();
+            float fade = Math.min(1f, f * 8f) * (1f - span(f, 0.78f, 1f));
+            for (int i = 0; i < n; i++) {
+                float y = (y0[i] + v[i] * f * 1.25f) * h;
+                if (y < -dp(10) || y > h + dp(10)) continue;
+                float x = x0[i] * w + wind * f * w * 0.25f + dp(14) * (float) Math.sin(ph[i] + f * 9f);
+                float size = dp(s[i]) * 2.4f;
+                p.setAlpha(Math.round(255 * a[i] * fade));
+                r.set(x - size / 2, y - size / 2, x + size / 2, y + size / 2);
+                c.drawBitmap(HolidayArt.glow(Math.round(dp(14)), 0xFFEAF4FF, 0.3f), null, r, p);
+            }
+        }
+    }
+
+    // ---- shooting star ----------------------------------------------------------------------------
+
+    /** One or two shooting stars across the upper sky. */
+    static final class ShootingStar extends Moment {
+        private final float[][] streaks;   // x0, y0 (fractions), angle, delay
+        private final Paint head = new Paint(Paint.FILTER_BITMAP_FLAG), tail = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private final RectF r = new RectF();
+
+        ShootingStar(Context c, int count, long seed) {
+            super(c);
+            Random rnd = new Random(seed);
+            streaks = new float[count][4];
+            for (int i = 0; i < count; i++) {
+                streaks[i][0] = 0.35f + rnd.nextFloat() * 0.6f;
+                streaks[i][1] = 0.05f + rnd.nextFloat() * 0.22f;
+                streaks[i][2] = (float) Math.toRadians(150 + rnd.nextInt(22));
+                streaks[i][3] = i * 0.28f;
+            }
+            tail.setStrokeCap(Paint.Cap.ROUND);
+        }
+
+        @Override
+        void frame(Canvas c, float f) {
+            int w = getWidth(), h = getHeight();
+            for (float[] s : streaks) {
+                float t = (f - s[3]) / (1f - s[3] * 0.9f);
+                if (t <= 0f || t >= 1f) continue;
+                float len = dp(300) * t, life = (float) Math.sin(Math.PI * t);
+                float ux = (float) Math.cos(s[2]), uy = (float) Math.sin(s[2]);
+                float hx = s[0] * w + ux * len, hy = s[1] * h + uy * len;
+                float tl = dp(130) * life;
+                for (int k = 0; k < 14; k++) {
+                    float q = k / 14f;
+                    tail.setColor(0xFFFFF4D8);
+                    tail.setAlpha(Math.round(200 * life * (1f - q)));
+                    tail.setStrokeWidth(dp(2.2f) * (1f - q));
+                    c.drawLine(hx - ux * tl * q, hy - uy * tl * q, hx - ux * tl * (q + 0.08f), hy - uy * tl * (q + 0.08f), tail);
+                }
+                int size = Math.round(dp(18));
+                head.setAlpha(Math.round(255 * life));
+                r.set(hx - size / 2f, hy - size / 2f, hx + size / 2f, hy + size / 2f);
+                c.drawBitmap(HolidayArt.glow(size, 0xFFFFF0C8, 0.15f), null, r, head);
+            }
+        }
+    }
+
+    // ---- sleigh -----------------------------------------------------------------------------------
+
+    /**
+     * A sleigh and four reindeer flying across the sky from right to left. Lit gold against the night with a trail
+     * of sparkles, or a dark silhouette when it crosses the moon.
+     */
+    static final class Sleigh extends Moment {
+        private final Path deer = new Path(), deerLines = new Path(), sleigh = new Path(), santa = new Path(),
+                reins = new Path();
+        private final Paint fill = new Paint(Paint.ANTI_ALIAS_FLAG), line = new Paint(Paint.ANTI_ALIAS_FLAG),
+                spark = new Paint(Paint.FILTER_BITMAP_FLAG), glowPaint = new Paint(Paint.FILTER_BITMAP_FLAG);
+        private final RectF r = new RectF();
+        private final boolean dark;
+        private final PointF across;   // a point the flight passes through (the moon), or null
+        private final float scale;
+
+        Sleigh(Context c, boolean dark, PointF across) {
+            super(c);
+            this.dark = dark;
+            this.across = across;
+            scale = c.getResources().getDisplayMetrics().density * 0.62f;
+            int col = dark ? 0xFF0A0E18 : 0xFFFFE7B3;
+            fill.setColor(col);
+            line.setColor(col);
+            line.setStyle(Paint.Style.STROKE);
+            line.setStrokeWidth(1.7f);
+            line.setStrokeCap(Paint.Cap.ROUND);
+            line.setStrokeJoin(Paint.Join.ROUND);
+            float[] xs = {0, 40, 80, 118};
+            float[] ys = {0, 3, -1, 2};
+            for (int i = 0; i < 4; i++) addDeer(xs[i], ys[i] + 8, i % 2 == 0);
+            // reins from the lead deer's chest back to the sleigh
+            reins.moveTo(10, 14);
+            reins.quadTo(90, 22, 168, 28);
+            // the sleigh: a curled runner and a body high at the back
+            sleigh.moveTo(160, 30);
+            sleigh.quadTo(156, 22, 166, 21);
+            sleigh.lineTo(172, 21);
+            sleigh.lineTo(176, 30);
+            sleigh.lineTo(210, 30);
+            sleigh.quadTo(214, 18, 212, 8);
+            sleigh.quadTo(206, 10, 204, 18);
+            sleigh.lineTo(180, 18);
+            sleigh.lineTo(176, 30);
+            sleigh.close();
+            santa.addCircle(190, 8, 4.4f, Path.Direction.CW);
+            santa.moveTo(186, 6);
+            santa.lineTo(194, 5);
+            santa.lineTo(198, -3);
+            santa.close();
+            santa.addOval(new RectF(181, 9, 200, 22), Path.Direction.CW);
+            santa.addOval(new RectF(197, 4, 211, 19), Path.Direction.CW);   // the sack
+            deerLines.moveTo(158, 34);
+            deerLines.quadTo(184, 37, 214, 33);   // the runner
+            deerLines.quadTo(220, 31, 218, 27);
+        }
+
+        private void addDeer(float x, float y, boolean stride) {
+            deer.addOval(new RectF(x + 7, y + 6, x + 29, y + 15), Path.Direction.CW);   // body
+            deer.addOval(new RectF(x - 1, y - 3, x + 7, y + 2), Path.Direction.CW);    // head
+            deerLines.moveTo(x + 9, y + 8);
+            deerLines.quadTo(x + 5, y + 4, x + 4, y);              // neck
+            deerLines.moveTo(x + 4, y - 2);
+            deerLines.lineTo(x + 7, y - 9);                          // antler
+            deerLines.moveTo(x + 6, y - 6);
+            deerLines.lineTo(x + 3, y - 9);
+            deerLines.moveTo(x + 7, y - 9);
+            deerLines.lineTo(x + 10, y - 11);
+            float s = stride ? 1f : -1f;
+            deerLines.moveTo(x + 10, y + 13);
+            deerLines.lineTo(x + 4 - s, y + 20);                     // front legs reaching forward
+            deerLines.moveTo(x + 13, y + 13);
+            deerLines.lineTo(x + 8 + s, y + 21);
+            deerLines.moveTo(x + 25, y + 13);
+            deerLines.lineTo(x + 32 + s, y + 18);                    // hind legs pushing back
+            deerLines.moveTo(x + 27, y + 12);
+            deerLines.lineTo(x + 35 - s, y + 15);
+            deerLines.moveTo(x + 29, y + 8);
+            deerLines.lineTo(x + 32, y + 6);                         // tail
+        }
+
+        private PointF at(float t, int w, int h) {
+            float x0 = w + dp(60), x2 = -dp(220);
+            float y0, y1, y2;
+            if (across != null) {
+                y0 = across.y + dp(40);
+                y2 = across.y - dp(30);
+                // the curve's middle passes through the moon at t = 0.5
+                y1 = 2 * across.y - (y0 + y2) / 2f;
+                float x1 = 2 * across.x - (x0 + x2) / 2f;
+                return quad(t, x0, x1, x2, y0, y1, y2);
+            }
+            // under the date line and the top bar, over the open sky
+            y0 = h * 0.33f;
+            y1 = h * 0.1f;
+            y2 = h * 0.28f;
+            return quad(t, x0, w * 0.5f, x2, y0, y1, y2);
+        }
+
+        private static PointF quad(float t, float x0, float x1, float x2, float y0, float y1, float y2) {
+            float u = 1 - t;
+            return new PointF(u * u * x0 + 2 * u * t * x1 + t * t * x2, u * u * y0 + 2 * u * t * y1 + t * t * y2);
+        }
+
+        @Override
+        void frame(Canvas c, float f) {
+            int w = getWidth(), h = getHeight();
+            if (w == 0) return;
+            float alpha = Math.min(1f, f * 6f) * (1f - span(f, 0.9f, 1f));
+            if (!dark) {
+                // a trail of sparkles where the sleigh has been
+                int size = Math.round(dp(10));
+                for (int k = 1; k <= 18; k++) {
+                    float tt = f - k * 0.012f;
+                    if (tt < 0) break;
+                    PointF p = at(tt, w, h);
+                    float jitter = dp(4) * (float) Math.sin(k * 2.1f + f * 40f);
+                    spark.setAlpha(Math.round(200 * alpha * (1f - k / 19f)));
+                    float sx = p.x + dp(130) * 0.62f + k * dp(1.5f), sy = p.y + dp(16) + jitter;
+                    r.set(sx - size / 2f, sy - size / 2f, sx + size / 2f, sy + size / 2f);
+                    c.drawBitmap(HolidayArt.glow(size, 0xFFFFE2A0, 0.2f), null, r, spark);
+                }
+            }
+            PointF p = at(f, w, h);
+            PointF q = at(Math.min(1f, f + 0.01f), w, h);
+            float tilt = (float) Math.toDegrees(Math.atan2(q.y - p.y, p.x - q.x));
+            int save = c.save();
+            c.translate(p.x, p.y);
+            c.rotate(-tilt * 0.6f);
+            c.scale(scale, scale);
+            if (!dark) {
+                glowPaint.setAlpha(Math.round(70 * alpha));
+                r.set(-20, -60, 240, 90);
+                c.drawBitmap(HolidayArt.glow(Math.round(dp(40)), 0xFFFFD98A, 0.05f), null, r, glowPaint);
+            }
+            fill.setAlpha(Math.round(255 * alpha));
+            line.setAlpha(Math.round(255 * alpha));
+            c.drawPath(deer, fill);
+            c.drawPath(deerLines, line);
+            c.drawPath(reins, line);
+            c.drawPath(sleigh, fill);
+            c.drawPath(santa, fill);
+            c.restoreToCount(save);
+        }
+    }
+
+    // ---- lights chase -----------------------------------------------------------------------------
+
+    /** The fairy lights flare one after another, left to right and back. */
+    static final class Chase extends Moment {
+        private final List<PointF> bulbs;
+        private final HolidayArt.LightString lights;
+        private final Paint p = new Paint(Paint.FILTER_BITMAP_FLAG);
+        private final RectF r = new RectF();
+
+        Chase(Context c, HolidayArt.LightString lights) {
+            super(c);
+            this.lights = lights;
+            bulbs = lights.bulbs();
+        }
+
+        @Override
+        void frame(Canvas c, float f) {
+            int n = bulbs.size();
+            if (n == 0) return;
+            float pos = f < 0.5f ? span(f, 0f, 0.5f) * (n + 6) - 3 : (1f - span(f, 0.5f, 1f)) * (n + 6) - 3;
+            int size = Math.round(dp(30));
+            for (int i = 0; i < n; i++) {
+                float k = (i - pos) / 2.4f;
+                float e = (float) Math.exp(-k * k);
+                if (e < 0.03f) continue;
+                PointF b = bulbs.get(i);
+                p.setAlpha(Math.round(255 * e));
+                r.set(b.x - size / 2f, b.y - size / 2f, b.x + size / 2f, b.y + size / 2f);
+                c.drawBitmap(HolidayArt.glow(size, lights.bulbColour(i), 0.16f), null, r, p);
+            }
+        }
+    }
+
+    // ---- snowflake --------------------------------------------------------------------------------
+
+    /** A large crystal snowflake turns in, glows, then breaks into flakes that drift down. */
+    static final class GiantFlake extends Moment {
+        private final float cx, cy, radius;
+        private final Paint halo = HolidayIcons.stroke(0x885FA8E8, 1f), line = HolidayIcons.stroke(0xFFF4FBFF, 1f),
+                bits = new Paint(Paint.FILTER_BITMAP_FLAG), core = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private final float[][] shards = new float[36][4];
+        private final RectF r = new RectF();
+
+        GiantFlake(Context c, float cx, float cy) {
+            super(c);
+            this.cx = cx;
+            this.cy = cy;
+            radius = dp(62);
+            Random rnd = new Random(0xF1A4EL);
+            for (float[] s : shards) {
+                double a = rnd.nextFloat() * Math.PI * 2;
+                float rr = rnd.nextFloat() * radius;
+                s[0] = (float) Math.cos(a) * rr;
+                s[1] = (float) Math.sin(a) * rr;
+                s[2] = (float) Math.cos(a) * dp(40 + rnd.nextInt(60));
+                s[3] = 1.5f + rnd.nextFloat() * 2.5f;
+            }
+            core.setShader(new RadialGradient(cx, cy, radius * 0.9f, new int[]{0x66DDF0FF, 0x22BFE3FF, 0x00BFE3FF},
+                    null, Shader.TileMode.CLAMP));
+        }
+
+        @Override
+        void frame(Canvas c, float f) {
+            float in = span(f, 0f, 0.32f), out = span(f, 0.6f, 0.85f);
+            float scale = 0.35f + 0.65f * in, alpha = in * (1f - out);
+            if (alpha > 0.01f) {
+                int save = c.save();
+                c.rotate(-70f * (1f - in) + 8f * span(f, 0.32f, 0.6f), cx, cy);
+                core.setAlpha(Math.round(255 * alpha));
+                c.drawCircle(cx, cy, radius * 0.9f * scale, core);
+                halo.setStrokeWidth(dp(5.5f) * scale);
+                halo.setAlpha(Math.round(130 * alpha));
+                line.setStrokeWidth(dp(2.4f) * scale);
+                line.setAlpha(Math.round(255 * alpha));
+                HolidayIcons.snowflake(c, cx, cy, radius * scale, halo);
+                HolidayIcons.snowflake(c, cx, cy, radius * scale, line);
+                c.restoreToCount(save);
+            }
+            float t = span(f, 0.58f, 1f);
+            if (t > 0f) {
+                int size = Math.round(dp(10));
+                for (float[] s : shards) {
+                    float x = cx + s[0] + s[2] * t * 0.5f, y = cy + s[1] + dp(120) * t * t + dp(30) * t;
+                    bits.setAlpha(Math.round(230 * (1f - t)));
+                    float sz = size * s[3] / 3f;
+                    r.set(x - sz, y - sz, x + sz, y + sz);
+                    c.drawBitmap(HolidayArt.glow(size, 0xFFEAF6FF, 0.3f), null, r, bits);
+                }
+            }
+        }
+    }
+
+    // ---- aurora -----------------------------------------------------------------------------------
+
+    /**
+     * Northern lights rippling across the top of the sky. Painted once at a quarter of the screen's size (they're
+     * soft anyway) and shown as one stretched bitmap, so only the fade and drift cost anything per frame.
+     */
+    static final class Aurora extends Moment {
+        private Bitmap art;
+        private final Paint p = new Paint(Paint.FILTER_BITMAP_FLAG);
+        private final RectF r = new RectF();
+
+        Aurora(Context c) {
+            super(c);
+        }
+
+        @Override
+        protected void onSizeChanged(int w, int h, int ow, int oh) {
+            if (w == 0 || h == 0) return;
+            int bw = w / 4, bh = h / 4;
+            art = Bitmap.createBitmap(bw, bh, Bitmap.Config.ARGB_8888);
+            Canvas c = new Canvas(art);
+            Paint strip = new Paint();
+            int[][] colors = {{0x0000FFAA, 0x3A30F0A6, 0x1626D3C8, 0x0026D3C8},
+                    {0x0000E0FF, 0x2448E6C8, 0x1080A8FF, 0x0080A8FF},
+                    {0x00A0FF80, 0x2E58F4A0, 0x0E26D3C8, 0x0026D3C8}};
+            float[][] wave = {{0.16f, 0.07f, 1.3f, 0.2f}, {0.22f, 0.06f, 1.9f, 1.4f}, {0.12f, 0.05f, 2.6f, 2.7f}};
+            for (int k = 0; k < 3; k++) {
+                float ch = bh * (0.42f + 0.1f * k);
+                strip.setShader(new LinearGradient(0, 0, 0, ch, colors[k], new float[]{0f, 0.35f, 0.75f, 1f},
+                        Shader.TileMode.CLAMP));
+                for (int x = 0; x < bw; x += 2) {
+                    float u = x / (float) bw;
+                    float base = bh * (wave[k][0] + wave[k][1] * (float) Math.sin(u * Math.PI * 2 * wave[k][2] + wave[k][3]));
+                    float fall = 0.6f + 0.4f * (float) Math.sin(u * Math.PI * 7 + k);
+                    c.save();
+                    c.translate(x, base);
+                    c.scale(1f, fall);
+                    c.drawRect(0, 0, 2, ch, strip);
+                    c.restore();
+                }
+            }
+        }
+
+        @Override
+        void frame(Canvas c, float f) {
+            if (art == null) return;
+            float a = span(f, 0f, 0.3f) * (1f - span(f, 0.75f, 1f));
+            float drift = dp(40) * (f - 0.5f);
+            p.setAlpha(Math.round(200 * a));
+            r.set(drift - dp(30), 0, getWidth() + drift + dp(30), getHeight() * (1f + 0.04f * (float) Math.sin(f * 6)));
+            c.drawBitmap(art, null, r, p);
+        }
+    }
+
+    // ---- ornament drop, star, presents --------------------------------------------------------------
+
+    /** Today's ornament falls onto the tree and bounces into place. */
+    static final class OrnamentDrop extends Moment {
+        private final float x, y, radius;
+        private final int index;
+        private final Paint spark = new Paint(Paint.FILTER_BITMAP_FLAG);
+        private final RectF r = new RectF();
+
+        OrnamentDrop(Context c, float x, float y, float radius, int index) {
+            super(c);
+            this.x = x;
+            this.y = y;
+            this.radius = radius;
+            this.index = index;
+        }
+
+        @Override
+        void frame(Canvas c, float f) {
+            float t = Math.min(1f, f / 0.8f);
+            float fall = bounce(t);
+            float yy = -dp(30) + (y + dp(30)) * fall;
+            HolidayArt.LightTree.drawOrnament(c, x, yy, radius, index, d);
+            if (f > 0.55f) {
+                float s = span(f, 0.55f, 1f);
+                int size = Math.round(dp(46));
+                spark.setAlpha(Math.round(220 * (float) Math.sin(Math.PI * s)));
+                r.set(x - size / 2f, y - size / 2f, x + size / 2f, y + size / 2f);
+                c.drawBitmap(HolidayArt.glow(size, 0xFFFFE7A6, 0.08f), null, r, spark);
+            }
+        }
+
+        private static float bounce(float t) {
+            if (t < 0.6f) return (t / 0.6f) * (t / 0.6f);
+            float u = (t - 0.6f) / 0.4f;
+            return 1f - 0.08f * (float) Math.sin(Math.PI * u) * (1f - u);
+        }
+    }
+
+    /** The star on top of the tree lights up with a burst of rays. */
+    static final class StarFlare extends Moment {
+        private final float x, y;
+        private final Paint ray = HolidayIcons.stroke(0xFFFFF0C0, 1f), glowP = new Paint(Paint.FILTER_BITMAP_FLAG);
+        private final RectF r = new RectF();
+
+        StarFlare(Context c, float x, float y) {
+            super(c);
+            this.x = x;
+            this.y = y;
+        }
+
+        @Override
+        void frame(Canvas c, float f) {
+            float grow = span(f, 0f, 0.45f), fade = 1f - span(f, 0.6f, 1f);
+            HolidayArt.LightTree.drawStar(c, x, y, dp(13) * (0.4f + 0.6f * grow), d);
+            int size = Math.round(dp(140) * grow);
+            if (size > 2) {
+                glowP.setAlpha(Math.round(200 * fade));
+                r.set(x - size / 2f, y - size / 2f, x + size / 2f, y + size / 2f);
+                c.drawBitmap(HolidayArt.glow(Math.round(dp(60)), 0xFFFFE6A0, 0.06f), null, r, glowP);
+            }
+            for (int i = 0; i < 12; i++) {
+                double a = i * Math.PI / 6 + f * 0.8;
+                float len = dp(i % 2 == 0 ? 60 : 36) * grow;
+                ray.setStrokeWidth(dp(i % 2 == 0 ? 1.6f : 1f));
+                ray.setAlpha(Math.round(200 * fade));
+                c.drawLine(x + (float) Math.cos(a) * dp(14), y + (float) Math.sin(a) * dp(14),
+                        x + (float) Math.cos(a) * len, y + (float) Math.sin(a) * len, ray);
+            }
+        }
+    }
+
+    /** Christmas morning: the presents drop in under the tree. */
+    static final class PresentsDrop extends Moment {
+        private final float cx, bottom;
+
+        PresentsDrop(Context c, float cx, float bottom) {
+            super(c);
+            this.cx = cx;
+            this.bottom = bottom;
+        }
+
+        @Override
+        void frame(Canvas c, float f) {
+            float t = Math.min(1f, f / 0.7f);
+            float lift = t < 0.65f ? dp(70) * (1f - (t / 0.65f) * (t / 0.65f))
+                    : dp(6) * (float) Math.sin(Math.PI * (t - 0.65f) / 0.35f);
+            int save = c.saveLayerAlpha(0, 0, getWidth(), getHeight(), Math.round(255 * Math.min(1f, f * 5f)));
+            HolidayArt.LightTree.drawPresents(c, cx, bottom, Math.max(0f, lift), d);
+            c.restoreToCount(save);
+        }
+    }
+
+    /** A cardinal glides in from the right and lands on the last tile's snow (the view itself stays afterwards). */
+    static void flyIn(View bird, float toX, float toY, boolean reduced, Runnable landed) {
+        if (reduced) {
+            bird.setX(toX);
+            bird.setY(toY);
+            bird.setAlpha(1f);
+            if (landed != null) landed.run();
+            return;
+        }
+        float dens = bird.getResources().getDisplayMetrics().density;
+        float fromX = ((View) bird.getParent()).getWidth() + dens * 40f;
+        float fromY = toY - dens * 150f;
+        ValueAnimator a = ValueAnimator.ofFloat(0f, 1f);
+        a.setDuration(1800);
+        a.addUpdateListener(v -> {
+            float t = (float) v.getAnimatedValue();
+            float e = 1f - (1f - t) * (1f - t);
+            bird.setX(fromX + (toX - fromX) * e);
+            float arc = (float) Math.sin(Math.PI * t) * bird.getResources().getDisplayMetrics().density * 50f;
+            bird.setY(fromY + (toY - fromY) * e - arc);
+            bird.setRotation(10f * (1f - t));
+            bird.setAlpha(Math.min(1f, t * 4f));
+        });
+        a.addListener(new AnimatorListenerAdapter() {
+            @Override
+            public void onAnimationEnd(Animator animation) {
+                bird.setRotation(0f);
+                if (landed != null) landed.run();
+            }
+        });
+        a.start();
+    }
+}
