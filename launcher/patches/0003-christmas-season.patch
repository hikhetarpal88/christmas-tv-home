+    /** Frost feathering in from the four corners, for mornings below zero. */
+    static final class FrostView extends Still {
+        private final Paint line = new Paint(Paint.ANTI_ALIAS_FLAG), mist = new Paint(Paint.ANTI_ALIAS_FLAG);
