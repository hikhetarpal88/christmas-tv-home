@@ -0,0 +1,111 @@
+package io.github.maxhayim.smarthome;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNotNull;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertTrue;
+
+import org.json.JSONObject;
+import org.junit.Test;
+
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.List;
+
+/** Exclude patterns, scripts as one-press rows, and a robot vacuum as a toggle. */
+public class ExcludeScriptsVacuumTest {
+    static final String STATES = "["
+            + "{\"entity_id\":\"light.patio_light_segment_1\",\"state\":\"on\",\"attributes\":{\"friendly_name\":\"Segment 1\",\"brightness\":255}},"
+            + "{\"entity_id\":\"light.patio_light_segment_21\",\"state\":\"on\",\"attributes\":{\"brightness\":255}},"
+            + "{\"entity_id\":\"light.patio_string\",\"state\":\"on\",\"attributes\":{\"friendly_name\":\"Patio string\",\"brightness\":128}},"
+            + "{\"entity_id\":\"switch.sound_bar_music_mode\",\"state\":\"off\",\"attributes\":{}},"
+            + "{\"entity_id\":\"switch.sound_bar_night_sound\",\"state\":\"off\",\"attributes\":{\"friendly_name\":\"Night sound\"}},"
+            + "{\"entity_id\":\"script.movie_time\",\"state\":\"off\",\"attributes\":{\"friendly_name\":\"Movie time\"}},"
+            + "{\"entity_id\":\"vacuum.robovac\",\"state\":\"docked\",\"attributes\":{\"friendly_name\":\"RoboVac\"}},"
+            + "{\"entity_id\":\"vacuum.upstairs\",\"state\":\"cleaning\",\"attributes\":{}},"
+            + "{\"entity_id\":\"vacuum.gone\",\"state\":\"unavailable\",\"attributes\":{}}"
+            + "]";
+
+    private static Ha.Entity find(List<Ha.Entity> all, String id) {
+        for (Ha.Entity e : all) if (e.id.equals(id)) return e;
+        return null;
+    }
+
+    @Test
+    public void excludePatternsLeaveMatchingEntitiesOut() throws Exception {
+        List<Ha.Entity> all = Ha.parse(STATES, Collections.emptyList(),
+                Arrays.asList("light.*_segment_*", "switch.*_music_mode"));
+        assertNull(find(all, "light.patio_light_segment_1"));
+        assertNull(find(all, "light.patio_light_segment_21"));
+        assertNull(find(all, "switch.sound_bar_music_mode"));
+        assertNotNull(find(all, "light.patio_string"));
+        assertNotNull(find(all, "switch.sound_bar_night_sound"));
+        assertEquals(Ha.parse(STATES).size() - 3, all.size());
+    }
+
+    @Test
+    public void noPatternsKeepsEverything() throws Exception {
+        assertEquals(Ha.parse(STATES).size(), Ha.parse(STATES, Collections.emptyList(), Collections.emptyList()).size());
+    }
+
+    @Test
+    public void patternsAreLiteralApartFromTheStar() {
+        assertTrue(Ha.globMatches("light.*_segment_*", "light.patio_light_segment_3"));
+        assertTrue(Ha.globMatches("switch.fan*", "switch.fan_plug"));
+        assertTrue(Ha.globMatches("switch.fan*", "switch.fan"));
+        assertTrue(Ha.globMatches("*", "anything.at_all"));
+        assertTrue(Ha.globMatches("sensor.x", "sensor.x"));
+        assertTrue(Ha.globMatches("a*b*c", "a_b_b_c"));
+        assertFalse("whole id, not a prefix", Ha.globMatches("switch.fan", "switch.fan_plug"));
+        assertFalse("the dot is a dot", Ha.globMatches("light.a", "lightxa"));
+        assertFalse(Ha.globMatches("light.*_segment_*", "switch.patio_light_segment_3"));
+        assertFalse(Ha.globMatches("a*b*c", "a_b_b_"));
+        assertFalse(Ha.globMatches("", "x"));
+    }
+
+    @Test
+    public void excludeComesInThroughThePushedConfig() throws Exception {
+        assertEquals(Arrays.asList("light.*_segment_*", "switch.fan_*"),
+                Config.parseGlance(new JSONObject("{\"exclude\":[\"light.*_segment_*\",\" \",\"switch.fan_*\"]}").opt("exclude")));
+    }
+
+    @Test
+    public void scriptsRunLikeScenes() throws Exception {
+        Ha.Entity s = find(Ha.parse(STATES), "script.movie_time");
+        assertEquals(Ha.Kind.SCENE, s.kind);
+        assertEquals("Run", s.value());
+        Ha.Call c = Ha.press(s);
+        assertEquals("/api/services/script/turn_on", c.path);
+        assertEquals("{\"entity_id\":\"script.movie_time\"}", c.body);
+        assertEquals("scenes still go to scene", "/api/services/scene/turn_on",
+                Ha.press(find(Ha.parse(HaTest.STATES), "scene.good_night")).path);
+    }
+
+    @Test
+    public void aSceneThatNeverRanStillRuns() throws Exception {
+        List<Ha.Entity> all = Ha.parse("["
+                + "{\"entity_id\":\"scene.diwali\",\"state\":\"unknown\",\"attributes\":{\"friendly_name\":\"Diwali\"}},"
+                + "{\"entity_id\":\"scene.gone\",\"state\":\"unavailable\",\"attributes\":{}},"
+                + "{\"entity_id\":\"switch.new\",\"state\":\"unknown\",\"attributes\":{}}]");
+        Ha.Entity never = find(all, "scene.diwali");
+        assertEquals("Run", never.value());
+        assertEquals("/api/services/scene/turn_on", Ha.press(never).path);
+        assertNull(Ha.press(find(all, "scene.gone")));
+        assertNull("other kinds still treat unknown as unavailable", Ha.press(find(all, "switch.new")));
+    }
+
+    @Test
+    public void aVacuumStartsWhenDockedAndGoesHomeWhenOut() throws Exception {
+        List<Ha.Entity> all = Ha.parse(STATES);
+        Ha.Entity docked = find(all, "vacuum.robovac");
+        assertEquals(Ha.Kind.TOGGLE, docked.kind);
+        assertEquals("Docked", docked.value());
+        assertEquals("/api/services/vacuum/start", Ha.press(docked).path);
+        Ha.Entity out = find(all, "vacuum.upstairs");
+        assertEquals("Cleaning", out.value());
+        assertEquals("/api/services/vacuum/return_to_base", Ha.press(out).path);
+        assertNull("vacuums don't dim", Ha.step(docked, 1));
+        assertNull(Ha.press(find(all, "vacuum.gone")));
+    }
+}
