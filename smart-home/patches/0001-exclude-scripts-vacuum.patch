+    /** Whether id matches one of the exclude patterns ("*" matches anything). */
+    static boolean excluded(String id, List<String> patterns) {
+        if (patterns == null) return false;
+        for (String p : patterns) if (globMatches(p, id)) return true;
+        return false;
+    }
+
+    /**
+     * Whether the whole of {@code s} matches {@code pattern}, where "*" stands for any run of characters and
+     * every other character is literal ("light.*_segment_*"). A plain character loop, no regular expressions.
+     */
+    static boolean globMatches(String pattern, String s) {
+        int p = 0, i = 0, star = -1, mark = 0;
+        while (i < s.length()) {
+            if (p < pattern.length() && pattern.charAt(p) == '*') {
+                star = p++;
+                mark = i;
+            } else if (p < pattern.length() && pattern.charAt(p) == s.charAt(i)) {
+                p++;
+                i++;
+            } else if (star >= 0) {
+                p = star + 1;   // let the last "*" swallow one more character and try again
+                i = ++mark;
+            } else {
+                return false;
+            }
+        }
+        while (p < pattern.length() && pattern.charAt(p) == '*') p++;
+        return p == pattern.length();
+    }
