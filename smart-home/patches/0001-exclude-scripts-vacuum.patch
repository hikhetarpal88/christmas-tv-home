diff --git a/addons/smart-home/app/src/test/java/io/github/maxhayim/smarthome/ExcludeScriptsVacuumTest.java b/addons/smart-home/app/src/test/java/io/github/maxhayim/smarthome/ExcludeScriptsVacuumTest.java
