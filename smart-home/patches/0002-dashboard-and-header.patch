@@ -0,0 +1,130 @@
+package io.github.maxhayim.smarthome;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+
+import java.time.Instant;
+import java.time.OffsetDateTime;
+import java.time.ZoneId;
+import java.time.format.DateTimeFormatter;
+import java.time.format.DateTimeParseException;
+import java.time.format.FormatStyle;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+
+/**
+ * Who's home and the front door, from GET /api/states (bravia), for the dashboard's header and its Front door tile.
+ * Settings come from the pushed config's "summary" object: {"doorbell": the automation whose last run is the last
+ * ring}. Pure Java and org.json, so JVM tests cover it.
+ */
+final class Summary {
+    /** For this long after the doorbell automation last ran, the door "rang"; after that it's quiet. */
+    static final long RANG_WINDOW_S = 6 * 3600;
+
+    static final class Person {
+        final String name;
+        final String state;
+
+        Person(String name, String state) {
+            this.name = name;
+            this.state = state;
+        }
+
+        boolean home() {
+            return "home".equals(state);
+        }
+    }
+
+    private Summary() {
+    }
+
+    /** person.* entities: the first word of the friendly name and the state, in Home Assistant's order. */
+    static List<Person> people(JSONArray states) {
+        List<Person> out = new ArrayList<>();
+        for (int i = 0; i < states.length(); i++) {
+            JSONObject o = states.optJSONObject(i);
+            if (o == null || !o.optString("entity_id").startsWith("person.")) continue;
+            String name = friendly(o).trim();
+            int space = name.indexOf(' ');
+            if (space > 0) name = name.substring(0, space);
+            if (name.isEmpty()) continue;
+            out.add(new Person(name, o.optString("state", "unknown")));
+        }
+        return out;
+    }
+
+    /** One line for people: "Everyone's home", "Nobody's home", "Alex is home", "Alex home, Sam away". */
+    static String headline(List<Person> people) {
+        if (people.isEmpty()) return "";
+        int home = 0;
+        for (Person p : people) if (p.home()) home++;
+        if (people.size() == 1) return people.get(0).name + (home == 1 ? " is home" : " is " + where(people.get(0)));
+        if (home == people.size()) return "Everyone's home";
+        if (home == 0) return "Nobody's home";
+        StringBuilder b = new StringBuilder();
+        for (Person p : people) {
+            if (b.length() > 0) b.append(", ");
+            b.append(p.name).append(p.home() ? " home" : " " + (p.state.equals("not_home") ? "away" : "at " + zone(p.state)));
+        }
+        return b.toString();
+    }
+
+    /** "away", or "at Work" for a zone. */
+    static String where(Person p) {
+        return "not_home".equals(p.state) || "unknown".equals(p.state) || "unavailable".equals(p.state)
+                ? "away" : "at " + zone(p.state);
+    }
+
+    private static String zone(String state) {
+        String s = state.replace('_', ' ').trim();
+        return s.isEmpty() ? s : Character.toUpperCase(s.charAt(0)) + s.substring(1);
+    }
+
+    /**
+     * null when no doorbell is configured (or it isn't in Home Assistant); "" when it hasn't rung within
+     * {@link #RANG_WINDOW_S}; else the time it rang, like "2:14 PM".
+     */
+    static String doorRang(JSONArray states, Config c, long nowMs, ZoneId zone, Locale locale) {
+        JSONObject d = find(states, c.summarySettings().optString("doorbell", ""));
+        if (d == null) return null;
+        JSONObject a = d.optJSONObject("attributes");
+        String last = a == null ? "" : a.optString("last_triggered", "");
+        if (last.isEmpty() || "null".equals(last)) return "";
+        try {
+            Instant at = OffsetDateTime.parse(last).toInstant();
+            long ago = nowMs / 1000 - at.getEpochSecond();
+            if (ago < -60 || ago > RANG_WINDOW_S) return "";
+            return DateTimeFormatter.ofLocalizedTime(FormatStyle.SHORT).withLocale(locale).withZone(zone).format(at);
+        } catch (DateTimeParseException e) {
+            return "";
+        }
+    }
+
+    /** The icon for a switch, plug or helper, by domain and name. */
+    static String icon(String id, String name) {
+        String n = name.toLowerCase(Locale.ROOT);
+        if (id.startsWith("input_boolean.")) return "toggle";
+        if (id.startsWith("fan.") || n.contains("fan")) return "fan";
+        if (n.contains("sound bar") || n.contains("speaker")) return "speaker";
+        if (n.contains("lamp") || n.contains("lantern")) return "lamp";
+        if (n.contains("water")) return "drop";
+        if (n.contains("noise")) return "wave";
+        return "plug";
+    }
+
+    static String friendly(JSONObject o) {
+        JSONObject a = o.optJSONObject("attributes");
+        String n = a == null ? "" : a.optString("friendly_name", "");
+        return n.isEmpty() ? o.optString("entity_id") : n;
+    }
+
+    private static JSONObject find(JSONArray states, String id) {
+        if (id == null || id.isEmpty()) return null;
+        for (int i = 0; i < states.length(); i++) {
+            JSONObject o = states.optJSONObject(i);
+            if (o != null && id.equals(o.optString("entity_id"))) return o;
+        }
+        return null;
+    }
+}
