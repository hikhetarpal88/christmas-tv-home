+package io.github.maxhayim.smarthome;
+
+import android.content.Context;
+import android.content.res.ColorStateList;
+import android.graphics.Rect;
+import android.graphics.Typeface;
+import android.graphics.drawable.GradientDrawable;
+import android.text.TextUtils;
+import android.util.TypedValue;
+import android.view.Gravity;
+import android.view.View;
+import android.widget.FrameLayout;
+import android.widget.ImageView;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+
+/**
+ * One dashboard tile, in the manner of Apple's Home app (bravia). Off: dark glass, white name. On: light tile,
+ * dark name, the icon in its colour (amber for lights). Focus lifts the tile with a soft white glow instead of an
+ * outline. A dimmable light can show a brightness bar while Left and Right dim it. A wide tile is a scene pill.
+ */
+final class Tile extends FrameLayout {
+    static final int AMBER = 0xFFFFB21E;
+    static final int BLUE = 0xFF0A84FF;
+    static final int GREEN = 0xFF30D158;
+
+    private final float dp;
+    private final boolean wide;
+    private final GradientDrawable bg = new GradientDrawable();
+    private final ImageView icon;
+    private final TextView name;
+    private final TextView state;
+    private final View barFill;
+    private final LinearLayout bar;
+    private boolean on;
+    private int onColor = AMBER;
+
+    Tile(Context c, boolean wide) {
+        super(c);
+        this.wide = wide;
+        dp = c.getResources().getDisplayMetrics().density;
+        setFocusable(true);
+        setClickable(true);
+        setClipToOutline(false);
+        bg.setCornerRadius((wide ? 20 : 22) * dp);
+        setBackground(bg);
+        Typeface medium = Typeface.create("sans-serif-medium", Typeface.NORMAL);
+
+        icon = new ImageView(c);
+        name = new TextView(c);
+        name.setTypeface(medium);
+        name.setTextSize(TypedValue.COMPLEX_UNIT_SP, wide ? 17 : 15);
+        name.setEllipsize(TextUtils.TruncateAt.END);
+        state = new TextView(c);
+        state.setTextSize(TypedValue.COMPLEX_UNIT_SP, wide ? 13 : 13);
+        state.setSingleLine(true);
+        state.setEllipsize(TextUtils.TruncateAt.END);
+
+        bar = new LinearLayout(c);
+        bar.setOrientation(LinearLayout.HORIZONTAL);
+        GradientDrawable track = new GradientDrawable();
+        track.setCornerRadius(2 * dp);
+        track.setColor(0x26000000);
+        bar.setBackground(track);
+        barFill = new View(c);
+        GradientDrawable fill = new GradientDrawable();
+        fill.setCornerRadius(2 * dp);
+        fill.setColor(AMBER);
+        barFill.setBackground(fill);
+        bar.addView(barFill, new LinearLayout.LayoutParams(0, LayoutParams.MATCH_PARENT, 0f));
+        bar.addView(new View(c), new LinearLayout.LayoutParams(0, LayoutParams.MATCH_PARENT, 1f));
+        bar.setVisibility(GONE);
+
+        int pad = Math.round((wide ? 18 : 14) * dp);
+        if (wide) {
+            LinearLayout row = new LinearLayout(c);
+            row.setOrientation(LinearLayout.HORIZONTAL);
+            row.setGravity(Gravity.CENTER_VERTICAL);
+            row.setPadding(pad, 0, pad, 0);
+            row.addView(icon, new LinearLayout.LayoutParams(Math.round(26 * dp), Math.round(26 * dp)));
+            LinearLayout text = new LinearLayout(c);
+            text.setOrientation(LinearLayout.VERTICAL);
+            name.setSingleLine(true);
+            text.addView(name);
+            text.addView(state);
+            LinearLayout.LayoutParams tp = new LinearLayout.LayoutParams(0, LayoutParams.WRAP_CONTENT, 1f);
+            tp.setMarginStart(Math.round(14 * dp));
+            row.addView(text, tp);
+            addView(row, new LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.MATCH_PARENT));
+        } else {
+            LinearLayout col = new LinearLayout(c);
+            col.setOrientation(LinearLayout.VERTICAL);
+            col.setPadding(pad, pad, pad, Math.round(12 * dp));
+            col.addView(icon, new LinearLayout.LayoutParams(Math.round(30 * dp), Math.round(30 * dp)));
+            col.addView(new View(c), new LinearLayout.LayoutParams(1, 0, 1f));
+            name.setMaxLines(2);
+            col.addView(name);
+            col.addView(state);
+            LinearLayout.LayoutParams bp = new LinearLayout.LayoutParams(LayoutParams.MATCH_PARENT, Math.round(4 * dp));
+            bp.topMargin = Math.round(6 * dp);
+            col.addView(bar, bp);
+            addView(col, new LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.MATCH_PARENT));
+        }
+        restyle();
+    }
+
+    /** onColor tints the icon when on: AMBER for lights, BLUE for switches, GREEN for a running vacuum. */
+    void bind(int iconRes, String title, String status, boolean on, boolean available, int onColor) {
+        this.on = on && available;
+        this.onColor = onColor;
+        icon.setImageResource(iconRes);
+        name.setText(title);
+        state.setText(status);
+        state.setVisibility(status == null || status.isEmpty() ? GONE : VISIBLE);
+        setAlpha(available ? 1f : 0.45f);
+        restyle();
+    }
+
+    boolean isOn() {
+        return on;
+    }
+
+    /** A brightness bar, 0 to 1, shown while Left and Right dim the light. */
+    void setBar(float fraction, boolean visible) {
+        bar.setVisibility(visible ? VISIBLE : GONE);
+        LinearLayout.LayoutParams lp = (LinearLayout.LayoutParams) barFill.getLayoutParams();
+        lp.weight = Math.max(0f, Math.min(1f, fraction));
+        ((LinearLayout.LayoutParams) bar.getChildAt(1).getLayoutParams()).weight = 1f - lp.weight;
+        bar.requestLayout();
+    }
+
+    /** Briefly swaps the icon, e.g. a green check after a scene ran. */
+    void flash(int iconRes, int color, String status) {
+        icon.setImageResource(iconRes);
+        icon.setImageTintList(ColorStateList.valueOf(color));
+        if (status != null) {
+            state.setText(status);
+            state.setVisibility(VISIBLE);
+        }
+    }
+
+    private void restyle() {
+        boolean focused = isFocused();
+        if (on) {
+            bg.setColor(0xFFF2F2F7);
+            name.setTextColor(0xFF1C1C1E);
+            state.setTextColor(0xFF6C6C70);
+            icon.setImageTintList(ColorStateList.valueOf(onColor));
+        } else {
+            bg.setColor(focused ? 0x42FFFFFF : 0x1FFFFFFF);
+            name.setTextColor(0xFFFFFFFF);
+            state.setTextColor(0x99FFFFFF);
+            icon.setImageTintList(ColorStateList.valueOf(wide ? 0xFFFFC94D : 0xCCFFFFFF));
+        }
+    }
+
+    @Override
+    protected void onFocusChanged(boolean gainFocus, int direction, Rect previouslyFocusedRect) {
+        super.onFocusChanged(gainFocus, direction, previouslyFocusedRect);
+        restyle();
+        float scale = gainFocus ? (wide ? 1.05f : 1.08f) : 1f;
+        animate().scaleX(scale).scaleY(scale).translationZ(gainFocus ? 14 * dp : 0).setDuration(150).start();
+        if (android.os.Build.VERSION.SDK_INT >= 28) {   // a white glow, not a black shadow, on the dark page
+            setOutlineSpotShadowColor(0x8CFFFFFF);
+            setOutlineAmbientShadowColor(0x59FFFFFF);
+        }
+    }
+}
