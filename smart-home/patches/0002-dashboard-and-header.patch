@@ -0,0 +1,94 @@
+package io.github.maxhayim.smarthome;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertTrue;
+
+import org.json.JSONArray;
+import org.junit.Test;
+
+import java.time.ZoneId;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.List;
+import java.util.Locale;
+
+/** Who's home and the front door, for the dashboard (bravia). */
+public class SummaryTest {
+    static final long NOW = 1_762_470_000_000L;          // 2025-11-06T23:00:00Z
+    static final ZoneId ZONE = java.time.ZoneOffset.ofHours(-8);   // fixed, so tz data updates cannot move it
+
+    static String states(String... extra) {
+        StringBuilder b = new StringBuilder("["
+                + "{\"entity_id\":\"person.alex_morgan\",\"state\":\"home\",\"attributes\":{\"friendly_name\":\"Alex Morgan\"}},"
+                + "{\"entity_id\":\"person.sam\",\"state\":\"not_home\",\"attributes\":{\"friendly_name\":\"Sam\"}},"
+                + "{\"entity_id\":\"light.floor\",\"state\":\"on\",\"attributes\":{\"friendly_name\":\"Floor Lamp\",\"brightness\":153}},"
+                + "{\"entity_id\":\"light.table\",\"state\":\"off\",\"attributes\":{\"friendly_name\":\"Table Lamp\"}},"
+                + "{\"entity_id\":\"light.patio_light_segment_1\",\"state\":\"on\",\"attributes\":{}},"
+                + "{\"entity_id\":\"light.patio_all\",\"state\":\"on\",\"attributes\":{\"friendly_name\":\"Patio All\",\"entity_id\":[\"light.a\",\"light.b\"]}},"
+                + "{\"entity_id\":\"vacuum.robovac\",\"state\":\"docked\",\"attributes\":{\"friendly_name\":\"RoboVac\"}},"
+                + "{\"entity_id\":\"switch.waterfall\",\"state\":\"on\",\"attributes\":{\"friendly_name\":\"Waterfall\"}},"
+                + "{\"entity_id\":\"input_boolean.guest_mode\",\"state\":\"off\",\"attributes\":{\"friendly_name\":\"Guest Mode\"}}");
+        for (String e : extra) b.append(',').append(e);
+        return b.append(']').toString();
+    }
+
+    static Config config(String summary) {
+        return new Config("http://ha:8123", "t", Collections.emptyList(),
+                Arrays.asList("light.*_segment_*"), summary);
+    }
+
+    static String door(String lastTriggered) {
+        return "{\"entity_id\":\"automation.tv_front_door_pop_up\",\"state\":\"on\",\"attributes\":{\"last_triggered\":"
+                + (lastTriggered == null ? "null" : "\"" + lastTriggered + "\"") + "}}";
+    }
+
+    static final String SETTINGS = "{\"doorbell\":\"automation.tv_front_door_pop_up\","
+            + "\"extras\":[\"input_boolean.guest_mode\",\"switch.waterfall\"]}";
+
+    @Test
+    public void peopleAreFirstNamesWithTheirState() throws Exception {
+        List<Summary.Person> p = Summary.people(new JSONArray(states()));
+        assertEquals(2, p.size());
+        assertEquals("Alex", p.get(0).name);
+        assertTrue(p.get(0).home());
+        assertEquals("Sam", p.get(1).name);
+        assertFalse(p.get(1).home());
+    }
+
+    @Test
+    public void headlines() {
+        Summary.Person h = new Summary.Person("Alex", "home");
+        Summary.Person b = new Summary.Person("Sam", "home");
+        Summary.Person away = new Summary.Person("Sam", "not_home");
+        Summary.Person work = new Summary.Person("Sam", "Work");
+        assertEquals("Everyone's home", Summary.headline(Arrays.asList(h, b)));
+        assertEquals("Alex home, Sam away", Summary.headline(Arrays.asList(h, away)));
+        assertEquals("Alex home, Sam at Work", Summary.headline(Arrays.asList(h, work)));
+        assertEquals("Nobody's home", Summary.headline(Arrays.asList(new Summary.Person("Alex", "not_home"), away)));
+        assertEquals("Alex is home", Summary.headline(Collections.singletonList(h)));
+        assertEquals("", Summary.headline(Collections.emptyList()));
+    }
+
+    @Test
+    public void aRecentRingShowsItsTime() throws Exception {
+        String rang = Summary.doorRang(new JSONArray(states(door("2025-11-06T22:14:03.123456+00:00"))),
+                config(SETTINGS), NOW, ZONE, Locale.US);
+        assertTrue(rang, rang.startsWith("2:14"));       // 22:14Z is 2:14 PM at UTC-8
+    }
+
+    @Test
+    public void anOldRingIsQuietAndNoDoorbellMeansNothing() throws Exception {
+        assertEquals("", Summary.doorRang(new JSONArray(states(door("2025-11-05T22:14:03+00:00"))),
+                config(SETTINGS), NOW, ZONE, Locale.US));
+        assertNull(Summary.doorRang(new JSONArray(states()), config(SETTINGS), NOW, ZONE, Locale.US));
+        assertNull(Summary.doorRang(new JSONArray(states(door(null))), config(""), NOW, ZONE, Locale.US));
+    }
+
+    @Test
+    public void summarySettingsSurviveBadJson() {
+        assertEquals(0, config("not json").summarySettings().length());
+        assertEquals("automation.x", config("{\"doorbell\":\"automation.x\"}").summarySettings().optString("doorbell"));
+    }
+}
